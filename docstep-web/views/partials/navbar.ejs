<header class="bg-white/85 backdrop-blur border-b border-slate-200 sticky top-0 z-40">
  <div class="max-w-[90rem] mx-auto px-4 py-3 flex items-center justify-between md:grid md:grid-cols-[1fr_auto_1fr]">
    <div class="flex justify-start">
      <a href="/" class="logo-mark">
        <img src="/images/logo.png" alt="DocStep logo" />
        <div class="wordmark">Doc<span>Step</span></div>
      </a>
    </div>

    <nav class="nav-links-desktop hidden md:flex items-center justify-center gap-1.5 lg:gap-2 xl:gap-3">
      <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
      <a class="nav-link <%= currentPath === '/about' ? 'active' : '' %>" href="/about">About</a>
      <a class="nav-link <%= currentPath === '/opportunities' ? 'active' : '' %>" href="/opportunities">Book Appointment</a>
      <a class="nav-link <%= currentPath === '/suggest-best-doctor' ? 'active' : '' %>" href="/suggest-best-doctor">Suggest Best Doctor</a>
      <a class="nav-link <%= currentPath === '/for-doctors' ? 'active' : '' %>" href="/for-doctors">For Doctors</a>
      <a class="nav-link <%= currentPath === '/for-employers' ? 'active' : '' %>" href="/for-employers">For Employers</a>
      <a class="nav-link <%= currentPath === '/community' ? 'active' : '' %>" href="/community">Community</a>
      <a class="nav-link <%= currentPath === '/courses' ? 'active' : '' %>" href="/courses">Courses</a>
      <a class="nav-link <%= currentPath === '/stories' ? 'active' : '' %>" href="/stories">Stories</a>
    </nav>

    <div class="flex items-center justify-end gap-2">
      <% if (user) { %>
        <% if (user.role === 'doctor') { %>
          <a href="/doctor/dashboard" class="btn btn-outline">Dashboard</a>
        <% } else if (user.role === 'employer') { %>
          <a href="/employer/dashboard" class="btn btn-outline">Dashboard</a>
        <% } else { %>
          <a href="/admin" class="btn btn-outline">Admin</a>
        <% } %>
        <a href="/logout" class="btn btn-ghost hidden md:inline-flex">Logout</a>
      <% } else { %>
        <a href="/login" class="btn btn-ghost hidden md:inline-flex">Login</a>
        <a href="/register" class="btn btn-primary">Get Started</a>
      <% } %>
      <button id="burger" class="md:hidden p-2 rounded-md hover:bg-slate-100" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="hidden md:hidden border-t border-slate-200 bg-white">
    <div class="px-4 py-3 flex flex-col gap-1 text-sm">
      <a href="/" class="py-2">Home</a>
      <a href="/about" class="py-2">About</a>
      <a href="/opportunities" class="py-2">Book Appointment</a>
      <a href="/suggest-best-doctor" class="py-2 font-medium text-slate-700 hover:text-teal-700">Suggest Best Doctor</a>
      <a href="/for-doctors" class="py-2">For Doctors</a>
      <a href="/for-employers" class="py-2">For Employers</a>
      <a href="/community" class="py-2">Community</a>
      <a href="/courses" class="py-2">Courses</a>
      <a href="/stories" class="py-2">Stories</a>
      <a href="/contact" class="py-2">Contact</a>
      <% if (!user) { %>
        <div class="border-t border-slate-200 pt-3 mt-2 flex gap-2">
          <a href="/login" class="btn btn-outline flex-1 justify-center">Login</a>
          <a href="/register" class="btn btn-primary flex-1 justify-center">Get Started</a>
        </div>
      <% } else { %>
        <div class="border-t border-slate-200 pt-3 mt-2 flex flex-col gap-2">
          <% if (user.role === 'doctor') { %>
            <a href="/doctor/dashboard" class="btn btn-outline justify-center">Doctor Dashboard</a>
          <% } else if (user.role === 'employer') { %>
            <a href="/employer/dashboard" class="btn btn-outline justify-center">Employer Dashboard</a>
          <% } else if (user.role === 'admin') { %>
            <a href="/admin/dashboard" class="btn btn-outline justify-center">Admin Dashboard</a>
          <% } %>
          <a href="/logout" class="btn btn-ghost text-red-600 justify-center">Logout</a>
        </div>
      <% } %>
    </div>
  </div>
</header>

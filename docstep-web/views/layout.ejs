<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — DocStep' : 'DocStep — Empowering Women Doctors' %></title>
  <meta name="description" content="DocStep helps women doctors restart their medical careers through flexible jobs, training, mentorship and telemedicine opportunities." />
  <link rel="icon" type="image/png" href="/images/favicon.png" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            teal: { 50:'#E0F4F3', 100:'#B6E3E1', 400:'#5EBFB7', 500:'#2BA3A0', 600:'#1F7B79', 700:'#155F5D' },
            lavender: { 50:'#F4F0FB', 100:'#E6DEF5', 300:'#B8A9E1', 500:'#8E7AC9', 700:'#5C4A98' },
            navy: { 700:'#243A63', 800:'#16243F', 900:'#0F1A2E' }
          },
          fontFamily: { display: ['Plus Jakarta Sans','sans-serif'], sans: ['Inter','sans-serif'] }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="antialiased">
  <%- include('partials/navbar') %>

  <main class="min-h-[60vh] fade-in">
    <% if (flash) { %>
      <div class="max-w-6xl mx-auto px-4 pt-4">
        <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
      </div>
    <% } %>
    <%- body %>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>

<!-- COURSES -->
<section class="hero-gradient">
  <div class="max-w-7xl mx-auto px-4 pt-14 pb-10">
    <div class="brand-pill mb-3">Courses & Training</div>
    <h1 class="font-display font-extrabold text-3xl md:text-5xl text-navy-800">Rebuild your skills, refresh your knowledge</h1>
    <p class="text-slate-600 mt-3 max-w-2xl">Short, self-paced courses from DocStep Academy and our training partners — designed for doctors returning to practice.</p>
  </div>
</section>

<!-- AI Matcher Control Panel -->
<div class="max-w-7xl mx-auto px-4 pt-6">
  <div class="card card-pad bg-white max-w-xl mx-auto p-6 shadow-sm border border-slate-100/80 rounded-2xl mb-6 text-left">
    <div class="flex items-center gap-2 mb-4">
      <span class="inline-flex items-center justify-center bg-teal-50 text-teal-700 w-8 h-8 rounded-lg">
        <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </span>
      <div>
        <h3 class="font-display font-bold text-base text-navy-800">Course Recommendations</h3>
        <p class="text-xs text-slate-500">Select any Primary Specialty to dynamically generate and retrieve course recommendations using Gemini AI.</p>
      </div>
    </div>
    
    <div>
      <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Select Primary Specialty</label>
      <select id="specialty-dropdown-select" class="w-full px-4 py-2.5 border border-slate-200 bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm font-semibold text-slate-700 cursor-pointer">
        <option value="">-- Choose Specialty --</option>
        <% const allSpecs = ["General Practice", "Gynecology", "Pediatrics", "Psychiatry", "Dermatology", "Internal Medicine", "Cardiology", "Other"]; %>
        <% allSpecs.forEach(spec => { %>
          <option value="<%= spec %>"><%= spec %></option>
        <% }) %>
      </select>
    </div>
    
    <!-- AI Status alert spinner -->
    <div id="ai-status-msg" class="hidden mt-4 text-xs font-semibold text-teal-700 bg-teal-50 border border-teal-100/50 rounded-xl p-3 flex items-center gap-2">
      <div class="animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-teal-600"></div>
      <span id="status-text">Gemini AI is generating recommendations for the selected specialty...</span>
    </div>
  </div>
</div>

<!-- Course Grid -->
<section class="max-w-7xl mx-auto px-4 py-6">
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="courses-grid">
    <% courses.forEach(c => { %>
      <a href="<%= c.website || '#' %>" target="_blank" class="course-card card overflow-hidden flex flex-col transition-all duration-500 transform hover:shadow-2xl hover:-translate-y-1.5 border border-slate-100 bg-white opacity-100 scale-100 no-underline text-slate-700" data-specialty="<%= c.specialty %>">
        <!-- Cover Image -->
        <div class="h-48 relative overflow-hidden group">
          <% if (c.image) { %>
            <img src="<%= c.image %>" alt="<%= c.title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <% } else { %>
            <div class="w-full h-full bg-gradient-to-br from-teal-400 via-lavender-300 to-navy-800"></div>
          <% } %>
          <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
            <span class="badge bg-white/95 text-navy-800 backdrop-blur-sm shadow-sm font-semibold text-xs py-1 px-2.5 rounded-full"><%= c.level || 'Intermediate' %></span>
            <span class="badge bg-teal-600 text-white shadow-sm font-semibold text-xs py-1 px-2.5 rounded-full"><%= c.specialty %></span>
          </div>
          <div class="absolute bottom-3 left-3 bg-navy-900/60 text-white px-2 py-0.5 rounded text-xxs backdrop-blur-xs">
            <%= c.provider || 'DocStep Academy' %>
          </div>
        </div>

        <!-- Details -->
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="font-display font-bold text-lg text-navy-800 leading-snug mb-1 hover:text-teal-700 transition-colors">
            <%= c.title %>
          </h3>
          <div class="text-xs text-teal-600 font-semibold mb-3">
            <%= c.instructor %>
          </div>
          <p class="text-sm text-slate-600 line-clamp-3 mb-4 leading-relaxed flex-1">
            <%= c.description %>
          </p>

          <!-- Key Stats (Single Lectures Stat) -->
          <div class="bg-slate-50/80 p-3 rounded-xl border border-slate-100/50 mb-5 text-center text-xs flex justify-center items-center gap-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span class="font-bold text-navy-800"><%= c.lectures_count || 12 %> Lectures</span>
          </div>

          <!-- Price & CTA -->
          <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-base font-bold text-teal-700">
              <%= c.price || 'Free' %>
            </span>
            <span class="btn btn-primary px-5 py-2.5 text-xs font-semibold hover:shadow-md transition-shadow inline-flex items-center gap-1">
              Explore Course &rarr;
            </span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
  
  <!-- Empty State -->
  <div id="empty-state" class="<%= courses.length === 0 ? '' : 'hidden' %> text-center py-16">
    <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
    </div>
    <h3 class="font-display font-bold text-xl text-navy-800 mb-1">No courses found</h3>
    <p class="text-slate-500 text-sm">Please select a Primary Specialty from the dropdown to load courses.</p>
  </div>
</section>

<!-- Suggest Section -->
<section class="section-soft py-16">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <div class="brand-pill mb-3">DocStep Academy</div>
    <h2 class="font-display font-bold text-3xl text-navy-800">More courses coming soon</h2>
    <p class="text-slate-600 mt-3">Suggest a course topic you'd love to see — we partner with PMDC-accredited institutes to roll out new programs each quarter.</p>
    <a href="/contact" class="btn btn-outline mt-6">Suggest a course</a>
  </div>
</section>

<!-- AI Matcher Script -->
<script>
  function createCourseCardHtml(c) {
    const price = c.price || 'Free';
    const imgHtml = c.image 
      ? `<img src="${c.image}" alt="${c.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />`
      : `<div class="w-full h-full bg-gradient-to-br from-teal-400 via-lavender-300 to-navy-800"></div>`;
    
    const lecturesCount = c.lecturesCount || c.lectures_count || 12;
    const description = c.description || `Comprehensive guide and training course covering key topics in ${c.specialty}.`;
    const website = c.website || `https://www.google.com/search?q=${encodeURIComponent(c.title + ' course')}`;

    return `
      <a href="${website}" target="_blank" class="course-card card overflow-hidden flex flex-col transition-all duration-500 transform hover:shadow-2xl hover:-translate-y-1.5 border border-slate-100 bg-white opacity-100 scale-100 no-underline text-slate-700" data-specialty="${c.specialty}">
        <!-- Cover Image -->
        <div class="h-48 relative overflow-hidden group">
          ${imgHtml}
          <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
            <span class="badge bg-white/95 text-navy-800 backdrop-blur-sm shadow-sm font-semibold text-xs py-1 px-2.5 rounded-full">${c.level || 'Intermediate'}</span>
            <span class="badge bg-teal-600 text-white shadow-sm font-semibold text-xs py-1 px-2.5 rounded-full">${c.specialty}</span>
          </div>
          <div class="absolute bottom-3 left-3 bg-navy-900/60 text-white px-2 py-0.5 rounded text-xxs backdrop-blur-xs">
            ${c.provider || 'DocStep Academy'}
          </div>
        </div>

        <!-- Details -->
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="font-display font-bold text-lg text-navy-800 leading-snug mb-1 hover:text-teal-700 transition-colors">
            ${c.title}
          </h3>
          <div class="text-xs text-teal-600 font-semibold mb-3">
            ${c.instructor}
          </div>
          <p class="text-sm text-slate-600 line-clamp-3 mb-4 leading-relaxed flex-1">
            ${description}
          </p>

          <!-- Key Stats (Single Lectures Stat) -->
          <div class="bg-slate-50/80 p-3 rounded-xl border border-slate-100/50 mb-5 text-center text-xs flex justify-center items-center gap-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span class="font-bold text-navy-800">${lecturesCount} Lectures</span>
          </div>

          <!-- Price & CTA -->
          <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-base font-bold text-teal-700">
              ${price}
            </span>
            <span class="btn btn-primary px-5 py-2.5 text-xs font-semibold hover:shadow-md transition-shadow inline-flex items-center gap-1">
              Explore Course &rarr;
            </span>
          </div>
        </div>
      </a>
    `;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const specialtySelect = document.getElementById('specialty-dropdown-select');
    const aiStatusMsg = document.getElementById('ai-status-msg');
    const statusText = document.getElementById('status-text');
    const coursesGrid = document.getElementById('courses-grid');
    const emptyState = document.getElementById('empty-state');

    async function fetchAiRecommendations(specialty) {
      if (!specialty.trim()) {
        coursesGrid.innerHTML = '';
        emptyState.innerHTML = `
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <h3 class="font-display font-bold text-xl text-navy-800 mb-1">No courses loaded</h3>
          <p class="text-slate-500 text-sm">Please select a Primary Specialty from the dropdown to load courses.</p>
        `;
        emptyState.classList.remove('hidden');
        emptyState.classList.add('block');
        return;
      }

      statusText.textContent = `Gemini AI is generating recommendations for: "${specialty}"...`;
      aiStatusMsg.classList.remove('hidden');
      aiStatusMsg.classList.add('flex');

      try {
        const res = await fetch(`/api/public/courses/recommend?specialty=${encodeURIComponent(specialty.trim())}`);
        const data = await res.json();

        if (data.success && data.courses) {
          if (data.courses.length === 0) {
            coursesGrid.innerHTML = '';
            emptyState.innerHTML = `
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              </div>
              <h3 class="font-display font-bold text-xl text-navy-800 mb-1">No courses found</h3>
              <p class="text-slate-500 text-sm">We couldn't generate courses in this category at the moment. Try selecting another specialty!</p>
            `;
            emptyState.classList.remove('hidden');
            emptyState.classList.add('block');
          } else {
            emptyState.classList.remove('block');
            emptyState.classList.add('hidden');
            coursesGrid.innerHTML = data.courses.map(c => createCourseCardHtml(c)).join('');
          }
        }
      } catch (err) {
        console.error('AI Matching failed:', err);
      } finally {
        aiStatusMsg.classList.remove('flex');
        aiStatusMsg.classList.add('hidden');
      }
    }

    // Trigger on Dropdown Change
    specialtySelect.addEventListener('change', (e) => {
      const val = e.target.value;
      fetchAiRecommendations(val);
    });
  });
</script>

<!-- BOOK APPOINTMENT VIEW -->
<div class="fade-in text-left">
  <section class="hero-gradient py-12">
    <div class="max-w-4xl mx-auto px-4">
      <a href="/opportunities" class="text-sm text-slate-500 hover:text-teal-700 flex items-center gap-1">
        &larr; Back to opportunities
      </a>
      <h1 class="font-display font-extrabold text-3xl md:text-4xl text-navy-800 mt-4">
        Book a Session
      </h1>
      <p class="text-slate-600 mt-2">
        Schedule an appointment with our verified medical professionals.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="card card-pad bg-white max-w-2xl mx-auto shadow-sm border border-slate-100 rounded-2xl p-6 md:p-8">
      <!-- Modern Mode Toggle Tabs -->
      <div class="flex p-1 bg-slate-100 rounded-xl mb-6">
        <button
          type="button"
          id="tab-book"
          class="flex-1 py-2 text-center text-sm font-semibold rounded-lg transition-all bg-white shadow-sm text-teal-700 font-medium"
        >
          Book New Session
        </button>
        <button
          type="button"
          id="tab-reschedule"
          class="flex-1 py-2 text-center text-sm font-semibold rounded-lg transition-all text-slate-500 hover:text-slate-700 font-medium"
        >
          Reschedule Appointment
        </button>
        <button
          type="button"
          id="tab-cancel"
          class="flex-1 py-2 text-center text-sm font-semibold rounded-lg transition-all text-slate-500 hover:text-slate-700 font-medium"
        >
          Cancel Appointment
        </button>
      </div>

      <h2 id="form-heading" class="font-display font-bold text-xl text-navy-800 mb-6 border-b border-slate-100 pb-3">Session Details</h2>
      
      <!-- Reschedule lookup UI -->
      <div id="reschedule-search-section" class="hidden space-y-4 mb-6">
        <div class="flex flex-col gap-1">
          <label class="block text-sm font-semibold text-slate-700 mb-1">Find Appointment by Patient Name</label>
          <div class="flex gap-2">
            <input
              type="text"
              id="reschedule-search-input"
              class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
              placeholder="Enter patient name..."
              value="<%= patientName %>"
            />
            <button
              type="button"
              id="reschedule-search-btn"
              class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-5 py-2 rounded-xl transition-colors shrink-0"
            >
              Search
            </button>
          </div>
        </div>

        <div id="reschedule-search-loading" class="text-center text-sm text-slate-500 py-6 hidden">Searching appointments...</div>

        <div id="reschedule-no-results" class="text-center bg-slate-50 rounded-xl p-6 border border-dashed border-slate-200 hidden">
          <p class="text-sm text-slate-500">No active appointments found.</p>
        </div>

        <div id="reschedule-search-results" class="space-y-3 hidden">
          <h3 class="text-sm font-semibold text-navy-800">Select Appointment to Reschedule</h3>
          <div id="reschedule-appointments-list" class="grid gap-3 max-h-72 overflow-y-auto pr-1">
            <!-- Populated dynamically -->
          </div>
        </div>
      </div>

      <!-- Cancel lookup UI -->
      <div id="cancel-search-section" class="hidden space-y-4 mb-6">
        <div class="flex flex-col gap-1">
          <label class="block text-sm font-semibold text-slate-700 mb-1">Find Appointment by Patient Name</label>
          <div class="flex gap-2">
            <input
              type="text"
              id="cancel-search-input"
              class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
              placeholder="Enter patient name..."
              value="<%= patientName %>"
            />
            <button
              type="button"
              id="cancel-search-btn"
              class="bg-red-600 hover:bg-red-700 text-white font-semibold px-5 py-2 rounded-xl transition-colors shrink-0"
            >
              Search
            </button>
          </div>
        </div>

        <div id="cancel-search-loading" class="text-center text-sm text-slate-500 py-6 hidden">Searching appointments...</div>

        <div id="cancel-no-results" class="text-center bg-slate-50 rounded-xl p-6 border border-dashed border-slate-200 hidden">
          <p class="text-sm text-slate-500">No active appointments found.</p>
        </div>

        <div id="cancel-search-results" class="space-y-3 hidden">
          <h3 class="text-sm font-semibold text-navy-800">Select Appointment to Cancel</h3>
          <div id="cancel-appointments-list" class="grid gap-3 max-h-72 overflow-y-auto pr-1">
            <!-- Populated dynamically -->
          </div>
        </div>
      </div>

      <form action="/book-appointment" method="POST" id="booking-form" class="space-y-4">
        
        <!-- Selected Appointment Details summary block -->
        <div id="selected-appointment-box" class="hidden bg-teal-50/50 border border-teal-100 rounded-xl p-4 mb-4 relative">
          <div class="text-xs uppercase tracking-wider text-teal-800 font-bold">Selected Appointment</div>
          <div id="selected-app-doctor" class="text-navy-800 font-semibold text-sm mt-1">Dr. Doctor &bull; Specialty</div>
          <div id="selected-app-time" class="text-xs text-slate-600 mt-0.5">Current Time: Time</div>
          <button
            type="button"
            id="change-selected-app-btn"
            class="absolute top-4 right-4 text-xs font-semibold text-teal-600 hover:text-teal-800 underline"
          >
            Change Selection
          </button>
        </div>

        <!-- Searchable Doctor Selection Dropdown -->
        <div class="relative select-container w-full" id="doctor-search-container">
          <label class="block text-sm font-semibold text-slate-700 mb-1">Search/Select Doctor</label>
          <input
            type="text"
            id="doctor-search-input"
            class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
            placeholder="Search doctor by name..."
            value="<%= selectedDoc ? selectedDoc.full_name : '' %>"
            autocomplete="off"
          />
          <input type="hidden" id="selected-doctor-id" name="doctor_id" value="<%= selectedDocId %>" required />
          
          <div 
            id="doctor-dropdown-menu" 
            class="hidden absolute z-50 w-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg max-h-60 overflow-y-auto"
          >
            <% doctors.forEach(doc => { %>
              <div
                class="doctor-opt p-3 hover:bg-slate-50 cursor-pointer border-b border-slate-100 last:border-b-0"
                data-id="<%= doc.id %>"
                data-name="<%= doc.name %>"
                data-specialty="<%= doc.specialty %>"
                data-availability="<%= doc.availability %>"
              >
                <div class="font-semibold text-navy-800 text-sm">Dr. <%= doc.name %></div>
                <div class="text-xs text-slate-500"><%= doc.specialty %> &bull; 🕒 <%= doc.availability %></div>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Doctor Name</label>
            <input 
              type="text" 
              id="doctor-name-locked"
              value="<%= selectedDoc ? 'Dr. ' + selectedDoc.full_name : '' %>" 
              readonly 
              class="w-full px-4 py-2 border border-slate-200 bg-slate-50 text-slate-600 font-semibold rounded-xl cursor-not-allowed" 
              placeholder="Choose doctor..."
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Primary Specialty</label>
            <input 
              type="text" 
              id="doctor-specialty-locked"
              value="<%= selectedDoc ? selectedDoc.specialty : '' %>" 
              readonly 
              class="w-full px-4 py-2 border border-slate-200 bg-slate-50 text-slate-600 rounded-xl cursor-not-allowed" 
              placeholder="Choose doctor..."
            />
          </div>
        </div>

        <!-- Availability Details Box -->
        <div id="availability-box" class="<%= selectedDoc ? '' : 'hidden' %> bg-teal-50/50 border border-teal-100 rounded-xl p-4 my-2">
          <div class="text-xs uppercase tracking-wider text-teal-800 font-bold">Doctor Availability</div>
          <div id="availability-text" class="text-navy-800 font-semibold text-sm mt-1">
            🕒 <%= selectedDoc ? selectedDoc.availability : '' %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Patient Name (User booking appointment)</label>
          <input 
            type="text" 
            name="patient_name"
            id="patient-name-input"
            required 
            value="<%= patientName %>"
            class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" 
            placeholder="Enter patient name" 
          />
        </div>

        <div class="grid md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Select Date</label>
            <input 
              type="date" 
              id="appointment-date"
              name="date"
              required 
              class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" 
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Day Name</label>
            <input 
              type="text" 
              id="appointment-day"
              readonly 
              class="w-full px-4 py-2 border border-slate-200 bg-slate-50 text-slate-500 font-semibold rounded-xl cursor-not-allowed" 
              placeholder="Auto-calculated" 
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Time Slot</label>
            <select 
              id="appointment-time-slot"
              name="time_slot"
              required 
              class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
            >
              <option value="">Choose slot...</option>
            </select>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex gap-3">
          <button 
            type="submit" 
            id="submit-btn"
            class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2 px-4 rounded-xl flex items-center justify-center gap-1 transition-colors"
          >
            Confirm Appointment Booking
          </button>
          <a href="/opportunities" id="cancel-btn" class="px-4 py-2 border border-slate-300 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-colors">Cancel</a>
        </div>
      </form>
      <!-- Premium Cancel Confirmation Modal -->
      <div id="cancel-confirm-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 transform scale-95 transition-all duration-300">
          <div class="flex items-center justify-center w-12 h-12 mx-auto bg-red-100 text-red-600 rounded-full mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h3 class="text-center font-display font-bold text-lg text-navy-800">Cancel Appointment?</h3>
          <p class="text-center text-sm text-slate-500 mt-2 mb-6 leading-relaxed">
            Are you sure you want to cancel this appointment with <strong id="cancel-modal-doctor" class="text-navy-800"></strong> on <span id="cancel-modal-date" class="font-semibold text-slate-700"></span>? This action cannot be undone.
          </p>
          <div class="flex gap-3">
            <button
              type="button"
              id="cancel-confirm-btn"
              class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 rounded-xl transition-colors text-sm"
            >
              Yes, Cancel
            </button>
            <button
              type="button"
              id="cancel-abort-btn"
              class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 rounded-xl transition-colors text-sm border border-slate-200"
            >
              No, Keep It
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const doctorSearchInput = document.getElementById('doctor-search-input');
  const selectedDoctorIdInput = document.getElementById('selected-doctor-id');
  const doctorDropdownMenu = document.getElementById('doctor-dropdown-menu');
  const doctorNameLocked = document.getElementById('doctor-name-locked');
  const doctorSpecialtyLocked = document.getElementById('doctor-specialty-locked');
  const availabilityBox = document.getElementById('availability-box');
  const availabilityText = document.getElementById('availability-text');
  const appointmentDate = document.getElementById('appointment-date');
  const appointmentDay = document.getElementById('appointment-day');
  const appointmentTimeSlot = document.getElementById('appointment-time-slot');
  const patientNameInput = document.getElementById('patient-name-input');
  const submitBtn = document.getElementById('submit-btn');
  const cancelBtn = document.getElementById('cancel-btn');
  
  // Reschedule DOM items
  const tabBook = document.getElementById('tab-book');
  const tabReschedule = document.getElementById('tab-reschedule');
  const tabCancel = document.getElementById('tab-cancel');
  const formHeading = document.getElementById('form-heading');
  const rescheduleSearchSection = document.getElementById('reschedule-search-section');
  const rescheduleSearchInput = document.getElementById('reschedule-search-input');
  const rescheduleSearchBtn = document.getElementById('reschedule-search-btn');
  const rescheduleSearchLoading = document.getElementById('reschedule-search-loading');
  const rescheduleNoResults = document.getElementById('reschedule-no-results');
  const rescheduleSearchResults = document.getElementById('reschedule-search-results');
  const rescheduleAppointmentsList = document.getElementById('reschedule-appointments-list');
  const bookingForm = document.getElementById('booking-form');
  const selectedAppointmentBox = document.getElementById('selected-appointment-box');
  const selectedAppDoctor = document.getElementById('selected-app-doctor');
  const selectedAppTime = document.getElementById('selected-app-time');
  const changeSelectedAppBtn = document.getElementById('change-selected-app-btn');

  // Cancel DOM items
  const cancelSearchSection = document.getElementById('cancel-search-section');
  const cancelSearchInput = document.getElementById('cancel-search-input');
  const cancelSearchBtn = document.getElementById('cancel-search-btn');
  const cancelSearchLoading = document.getElementById('cancel-search-loading');
  const cancelNoResults = document.getElementById('cancel-no-results');
  const cancelSearchResults = document.getElementById('cancel-search-results');
  const cancelAppointmentsList = document.getElementById('cancel-appointments-list');
  
  // Cancel Modal DOM items
  const cancelConfirmModal = document.getElementById('cancel-confirm-modal');
  const cancelModalDoctor = document.getElementById('cancel-modal-doctor');
  const cancelModalDate = document.getElementById('cancel-modal-date');
  const cancelConfirmBtn = document.getElementById('cancel-confirm-btn');
  const cancelAbortBtn = document.getElementById('cancel-abort-btn');

  let bookingMode = 'book'; // 'book', 'reschedule', or 'cancel'
  let selectedAppointment = null;
  let appointmentToCancel = null;
  
  const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

  // Prevent past dates selection
  const today = new Date().toISOString().split('T')[0];
  appointmentDate.setAttribute('min', today);

  // Tab switches
  tabBook.addEventListener('click', () => {
    bookingMode = 'book';
    tabBook.classList.add('bg-white', 'shadow-sm', 'text-teal-700');
    tabBook.classList.remove('text-slate-500', 'hover:text-slate-700');
    tabReschedule.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
    tabReschedule.classList.add('text-slate-500', 'hover:text-slate-700');
    tabCancel.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
    tabCancel.classList.add('text-slate-500', 'hover:text-slate-700');
    
    formHeading.textContent = 'Session Details';
    rescheduleSearchSection.classList.add('hidden');
    cancelSearchSection.classList.add('hidden');
    bookingForm.classList.remove('hidden');
    selectedAppointmentBox.classList.add('hidden');
    selectedAppointment = null;

    // Reset doctor selection
    selectedDoctorIdInput.value = '';
    doctorSearchInput.value = '';
    doctorNameLocked.value = '';
    doctorSpecialtyLocked.value = '';
    availabilityBox.classList.add('hidden');
    availabilityText.textContent = '';
    appointmentDate.value = '';
    appointmentDay.value = '';
    appointmentTimeSlot.innerHTML = '<option value="">Choose slot...</option>';
    submitBtn.textContent = 'Confirm Appointment Booking';
    cancelBtn.textContent = 'Cancel';
    cancelBtn.setAttribute('href', '/opportunities');
  });

  tabReschedule.addEventListener('click', () => {
    bookingMode = 'reschedule';
    tabReschedule.classList.add('bg-white', 'shadow-sm', 'text-teal-700');
    tabReschedule.classList.remove('text-slate-500', 'hover:text-slate-700');
    tabBook.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
    tabBook.classList.add('text-slate-500', 'hover:text-slate-700');
    tabCancel.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
    tabCancel.classList.add('text-slate-500', 'hover:text-slate-700');
    
    formHeading.textContent = 'Rescheduling Session Details';
    rescheduleSearchSection.classList.remove('hidden');
    cancelSearchSection.classList.add('hidden');
    bookingForm.classList.add('hidden'); // hidden until selected
    selectedAppointmentBox.classList.add('hidden');
    selectedAppointment = null;

    submitBtn.textContent = 'Confirm Reschedule';
    cancelBtn.textContent = 'Back';
    cancelBtn.setAttribute('href', '#');
  });

  tabCancel.addEventListener('click', () => {
    bookingMode = 'cancel';
    tabCancel.classList.add('bg-white', 'shadow-sm', 'text-teal-700');
    tabCancel.classList.remove('text-slate-500', 'hover:text-slate-700');
    tabBook.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
    tabBook.classList.add('text-slate-500', 'hover:text-slate-700');
    tabReschedule.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
    tabReschedule.classList.add('text-slate-500', 'hover:text-slate-700');

    formHeading.textContent = 'Cancel Appointment';
    cancelSearchSection.classList.remove('hidden');
    rescheduleSearchSection.classList.add('hidden');
    bookingForm.classList.add('hidden');
    selectedAppointmentBox.classList.add('hidden');
    selectedAppointment = null;
  });

  // Search appointments
  rescheduleSearchBtn.addEventListener('click', async () => {
    const query = rescheduleSearchInput.value.trim();
    if (!query) return;

    rescheduleSearchLoading.classList.remove('hidden');
    rescheduleNoResults.classList.add('hidden');
    rescheduleSearchResults.classList.add('hidden');
    rescheduleAppointmentsList.innerHTML = '';

    try {
      const res = await fetch(`/api/public/appointments/search?patient_name=${encodeURIComponent(query)}`);
      const data = await res.json();

      rescheduleSearchLoading.classList.add('hidden');

      if (data.success && data.appointments && data.appointments.length > 0) {
        rescheduleSearchResults.classList.remove('hidden');
        data.appointments.forEach(app => {
          const card = document.createElement('div');
          card.className = 'p-4 border border-slate-200 rounded-2xl hover:border-teal-400 hover:shadow-sm transition-all flex justify-between items-center bg-slate-50/50';
          card.innerHTML = `
            <div class="text-left">
              <h4 class="font-semibold text-navy-800 text-sm">Dr. ${app.doctor_name}</h4>
              <p class="text-xs text-slate-500">${app.primary_specialty}</p>
              <p class="text-xs text-teal-700 font-semibold mt-1">
                🕒 ${app.date} (${app.day}) &bull; ${app.time_slot}
              </p>
              <p class="text-[11px] text-slate-400 mt-0.5">Patient: ${app.patient_name}</p>
            </div>
            <button
              type="button"
              class="select-app-btn bg-teal-50 hover:bg-teal-100 text-teal-700 border border-teal-200 text-xs font-semibold px-3 py-1.5 rounded-xl transition-colors shrink-0"
              data-id="${app.id}"
            >
              Reschedule
            </button>
          `;
          
          card.querySelector('.select-app-btn').addEventListener('click', () => {
            selectAppointment(app);
          });
          
          rescheduleAppointmentsList.appendChild(card);
        });
      } else {
        rescheduleNoResults.classList.remove('hidden');
      }
    } catch (err) {
      console.error(err);
      rescheduleSearchLoading.classList.add('hidden');
      alert('Error searching appointments. Please try again.');
    }
  });

  // Search appointments to cancel
  cancelSearchBtn.addEventListener('click', async () => {
    const query = cancelSearchInput.value.trim();
    if (!query) return;

    cancelSearchLoading.classList.remove('hidden');
    cancelNoResults.classList.add('hidden');
    cancelSearchResults.classList.add('hidden');
    cancelAppointmentsList.innerHTML = '';

    try {
      const res = await fetch(`/api/public/appointments/search?patient_name=${encodeURIComponent(query)}`);
      const data = await res.json();

      cancelSearchLoading.classList.add('hidden');

      if (data.success && data.appointments && data.appointments.length > 0) {
        cancelSearchResults.classList.remove('hidden');
        data.appointments.forEach(app => {
          const card = document.createElement('div');
          card.className = 'p-4 border border-slate-200 rounded-2xl hover:border-red-400 hover:shadow-sm transition-all flex justify-between items-center bg-slate-50/50';
          card.innerHTML = `
            <div class="text-left">
              <h4 class="font-semibold text-navy-800 text-sm">Dr. ${app.doctor_name}</h4>
              <p class="text-xs text-slate-500">${app.primary_specialty}</p>
              <p class="text-xs text-red-600 font-semibold mt-1">
                🕒 ${app.date} (${app.day}) &bull; ${app.time_slot}
              </p>
              <p class="text-[11px] text-slate-400 mt-0.5">Patient: ${app.patient_name}</p>
            </div>
            <button
              type="button"
              class="cancel-app-btn bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-semibold px-3 py-1.5 rounded-xl transition-colors shrink-0"
              data-id="${app.id}"
            >
              Cancel Appointment
            </button>
          `;
          
          card.querySelector('.cancel-app-btn').addEventListener('click', () => {
            openCancelConfirmModal(app);
          });
          
          cancelAppointmentsList.appendChild(card);
        });
      } else {
        cancelNoResults.classList.remove('hidden');
      }
    } catch (err) {
      console.error(err);
      cancelSearchLoading.classList.add('hidden');
      alert('Error searching appointments. Please try again.');
    }
  });

  function openCancelConfirmModal(app) {
    appointmentToCancel = app;
    cancelModalDoctor.textContent = `Dr. ${app.doctor_name}`;
    cancelModalDate.textContent = `${app.date} (${app.day}) at ${app.time_slot}`;
    
    cancelConfirmModal.classList.remove('hidden');
    // Force a reflow
    cancelConfirmModal.offsetHeight;
    cancelConfirmModal.classList.remove('opacity-0');
    cancelConfirmModal.classList.add('opacity-100');
    cancelConfirmModal.firstElementChild.classList.remove('scale-95');
    cancelConfirmModal.firstElementChild.classList.add('scale-100');
  }

  function closeCancelConfirmModal() {
    cancelConfirmModal.classList.remove('opacity-100');
    cancelConfirmModal.classList.add('opacity-0');
    cancelConfirmModal.firstElementChild.classList.remove('scale-100');
    cancelConfirmModal.firstElementChild.classList.add('scale-95');
    
    setTimeout(() => {
      cancelConfirmModal.classList.add('hidden');
      appointmentToCancel = null;
    }, 300);
  }

  cancelAbortBtn.addEventListener('click', closeCancelConfirmModal);

  cancelConfirmBtn.addEventListener('click', async () => {
    if (!appointmentToCancel) return;
    
    cancelConfirmBtn.disabled = true;
    cancelConfirmBtn.textContent = 'Cancelling...';
    
    try {
      const res = await fetch(`/api/public/appointments/${appointmentToCancel.id}/cancel`, {
        method: 'POST'
      });
      
      const data = await res.json();
      if (data.success) {
        window.location.href = '/opportunities';
      } else {
        alert(data.error || 'Failed to cancel appointment.');
        cancelConfirmBtn.disabled = false;
        cancelConfirmBtn.textContent = 'Yes, Cancel';
      }
    } catch (err) {
      console.error(err);
      alert('Failed to cancel appointment. Please try again.');
      cancelConfirmBtn.disabled = false;
      cancelConfirmBtn.textContent = 'Yes, Cancel';
    }
  });

  function selectAppointment(app) {
    selectedAppointment = app;
    selectedDoctorIdInput.value = app.doctor_id;
    doctorSearchInput.value = app.doctor_name;
    doctorNameLocked.value = 'Dr. ' + app.doctor_name;
    doctorSpecialtyLocked.value = app.primary_specialty;
    availabilityText.textContent = '🕒 ' + (app.doctor_availability || 'Flexible');
    availabilityBox.classList.remove('hidden');
    patientNameInput.value = app.patient_name;
    appointmentDate.value = app.date;
    appointmentDay.value = app.day;

    selectedAppDoctor.innerHTML = `Dr. ${app.doctor_name} &bull; ${app.primary_specialty}`;
    selectedAppTime.textContent = `Current Time: ${app.date} (${app.day}) at ${app.time_slot}`;
    selectedAppointmentBox.classList.remove('hidden');

    rescheduleSearchSection.classList.add('hidden');
    bookingForm.classList.remove('hidden');

    loadTimeSlots().then(() => {
      appointmentTimeSlot.value = app.time_slot;
    });
  }

  changeSelectedAppBtn.addEventListener('click', () => {
    selectedAppointment = null;
    selectedAppointmentBox.classList.add('hidden');
    bookingForm.classList.add('hidden');
    rescheduleSearchSection.classList.remove('hidden');
  });

  cancelBtn.addEventListener('click', (e) => {
    if (bookingMode === 'reschedule' || bookingMode === 'cancel') {
      e.preventDefault();
      if (bookingMode === 'reschedule' && selectedAppointment) {
        // go back to search list
        changeSelectedAppBtn.click();
      } else {
        // go back to booking tab
        tabBook.click();
      }
    }
  });

  // Toggle dropdown on input focus / input search
  doctorSearchInput.addEventListener('focus', () => {
    doctorDropdownMenu.classList.remove('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.select-container')) {
      doctorDropdownMenu.classList.add('hidden');
    }
  });

  // Search filtering
  doctorSearchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    const opts = doctorDropdownMenu.querySelectorAll('.doctor-opt');
    let hasMatch = false;
    
    opts.forEach(opt => {
      const name = opt.getAttribute('data-name').toLowerCase();
      if (name.includes(query)) {
        opt.classList.remove('hidden');
        hasMatch = true;
      } else {
        opt.classList.add('hidden');
      }
    });

    if (hasMatch) {
      doctorDropdownMenu.classList.remove('hidden');
    } else {
      doctorDropdownMenu.classList.add('hidden');
    }

    if (!e.target.value) {
      selectedDoctorIdInput.value = '';
      doctorNameLocked.value = '';
      doctorSpecialtyLocked.value = '';
      availabilityBox.classList.add('hidden');
      availabilityText.textContent = '';
      appointmentTimeSlot.innerHTML = '<option value="">Choose slot...</option>';
    }
  });

  // Option select
  doctorDropdownMenu.addEventListener('click', (e) => {
    const opt = e.target.closest('.doctor-opt');
    if (!opt) return;

    const id = opt.getAttribute('data-id');
    const name = opt.getAttribute('data-name');
    const specialty = opt.getAttribute('data-specialty');
    const availability = opt.getAttribute('data-availability');

    selectedDoctorIdInput.value = id;
    doctorSearchInput.value = name;
    doctorNameLocked.value = 'Dr. ' + name;
    doctorSpecialtyLocked.value = specialty;
    availabilityText.textContent = '🕒 ' + availability;
    availabilityBox.classList.remove('hidden');

    doctorDropdownMenu.classList.add('hidden');

    // Trigger slot refresh if date is already filled
    loadTimeSlots();
  });

  // Calculate day name and fetch slots on date change
  appointmentDate.addEventListener('change', () => {
    const val = appointmentDate.value;
    if (val) {
      const parts = val.split('-');
      const localDate = new Date(parts[0], parts[1] - 1, parts[2]);
      appointmentDay.value = dayNames[localDate.getDay()];
    } else {
      appointmentDay.value = '';
    }
    loadTimeSlots();
  });

  // Load available time slots using fetch API
  async function loadTimeSlots() {
    const docId = selectedDoctorIdInput.value;
    const dateVal = appointmentDate.value;

    if (!docId || !dateVal) {
      appointmentTimeSlot.innerHTML = '<option value="">Choose slot...</option>';
      return;
    }

    appointmentTimeSlot.innerHTML = '<option value="">Loading slots...</option>';

    try {
      const res = await fetch(`/api/public/doctors/${docId}/availability?date=${dateVal}`);
      const data = await res.json();
      
      if (data.success && data.availableSlots && data.availableSlots.length > 0) {
        let html = '<option value="">Choose slot...</option>';
        data.availableSlots.forEach(slot => {
          html += `<option value="${slot}">${slot}</option>`;
        });
        appointmentTimeSlot.innerHTML = html;
      } else {
        appointmentTimeSlot.innerHTML = '<option value="" disabled>No slots available on this day</option>';
      }
    } catch (err) {
      console.error('Error fetching availability:', err);
      appointmentTimeSlot.innerHTML = '<option value="" disabled>Failed to load slots</option>';
    }
  }

  // Intercept submit for reschedule mode
  bookingForm.addEventListener('submit', async (e) => {
    if (bookingMode === 'reschedule') {
      e.preventDefault();
      
      if (!selectedAppointment) {
        alert('Please select an appointment first.');
        return;
      }
      
      const docId = selectedDoctorIdInput.value;
      const dateVal = appointmentDate.value;
      const slotVal = appointmentTimeSlot.value;
      
      if (!dateVal || !slotVal) {
        alert('Please select date and time slot.');
        return;
      }
      
      submitBtn.disabled = true;
      submitBtn.textContent = 'Rescheduling...';
      
      try {
        const res = await fetch(`/api/public/appointments/${selectedAppointment.id}/reschedule`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            doctor_id: docId,
            date: dateVal,
            time_slot: slotVal
          })
        });
        
        const data = await res.json();
        if (data.success) {
          window.location.href = '/opportunities';
        } else {
          alert(data.error || 'Failed to reschedule appointment.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Confirm Reschedule';
        }
      } catch (err) {
        console.error(err);
        alert('Failed to reschedule appointment. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Confirm Reschedule';
      }
    }
  });

  // If initial docId is set, fetch details and trigger loading initial slots
  if (selectedDoctorIdInput.value) {
    loadTimeSlots();
  }
});
</script>

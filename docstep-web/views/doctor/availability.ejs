<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/doctor-side') %>

    <div>
      <h1 class="font-display font-extrabold text-3xl text-navy-800 mb-2">Availability</h1>
      <p class="text-slate-600 mb-6">Set when and how you're open to work. Employers use this to match you.</p>

      <form method="post" action="/doctor/availability" class="card card-pad space-y-5 max-w-2xl">
        <div>
          <label class="label">Working schedule</label>
          <select name="availability" class="select">
            <% ['Flexible','Mornings only','Evenings & Weekends','Weekdays 10am-2pm','Weekday afternoons','Evenings','Weekends only'].forEach(a => { %>
              <option <%= profile.availability===a?'selected':'' %>><%= a %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="label">Hourly rate (PKR)</label>
          <input type="number" min="0" name="hourly_rate" value="<%= profile.hourly_rate %>" class="input" />
          <div class="text-xs text-slate-500 mt-1">Set 0 to keep it private.</div>
        </div>
        <div class="flex items-center gap-3">
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="open_to_remote" <%= profile.open_to_remote?'checked':'' %> class="w-4 h-4 accent-teal-600" />
            <span class="font-semibold text-navy-800">Open to remote / telemedicine roles</span>
          </label>
        </div>
        <button class="btn btn-primary">Save availability</button>
      </form>
    </div>
  </div>
</section>

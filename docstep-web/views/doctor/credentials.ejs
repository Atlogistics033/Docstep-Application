<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/doctor-side') %>

    <div>
      <h1 class="font-display font-extrabold text-3xl text-navy-800 mb-2">Credentials</h1>
      <p class="text-slate-600 mb-6">Upload PMDC certificate, degrees, and other documents. We verify them before showing to employers.</p>

      <div class="grid lg:grid-cols-[1fr_360px] gap-6">
        <div class="card card-pad">
          <h2 class="font-display font-bold text-lg text-navy-800 mb-4">My documents</h2>
          <% if (creds.length === 0) { %>
            <div class="text-sm text-slate-500">No credentials uploaded yet.</div>
          <% } else { %>
            <div class="divide-y divide-slate-100">
              <% creds.forEach(c => { %>
                <div class="py-3 flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <div class="font-semibold text-navy-800 truncate"><%= c.title %></div>
                    <div class="text-xs text-slate-500"><%= c.cred_type %> • <%= new Date(c.uploaded_at).toDateString() %></div>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="badge <%= c.verified?'badge-green':'badge-amber' %>"><%= c.verified?'Verified':'Pending' %></span>
                    <% if (c.file_path) { %><a href="<%= c.file_path %>" target="_blank" class="text-teal-700 text-sm font-semibold">View</a><% } %>
                    <form method="post" action="/doctor/credentials/<%= c.id %>/delete" onsubmit="return confirm('Delete this credential?')">
                      <button class="text-red-600 text-sm font-semibold">Delete</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="card card-pad">
          <h2 class="font-display font-bold text-lg text-navy-800 mb-4">Upload new</h2>
          <form method="post" action="/doctor/credentials/upload" enctype="multipart/form-data" class="space-y-3">
            <div>
              <label class="label">Type</label>
              <select name="cred_type" class="select" required>
                <option>PMDC Certificate</option>
                <option>Medical Degree (MBBS)</option>
                <option>Postgraduate (FCPS / MCPS / MRCOG)</option>
                <option>Specialization Certificate</option>
                <option>Other</option>
              </select>
            </div>
            <div><label class="label">Title / description</label><input name="title" required class="input" placeholder="e.g. PMDC Certificate 2020" /></div>
            <div>
              <label class="label">File (PDF, JPG, PNG — max 5MB)</label>
              <input type="file" name="file" accept="application/pdf,image/*" required class="input" />
            </div>
            <button class="btn btn-primary w-full justify-center">Upload</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

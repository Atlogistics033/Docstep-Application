<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/doctor-side') %>

    <div>
      <h1 class="font-display font-extrabold text-3xl text-navy-800 mb-2">CV Builder</h1>
      <p class="text-slate-600 mb-6">Build a professional CV tailored for doctors returning to clinical practice.</p>

      <div class="grid lg:grid-cols-2 gap-6">
        <form method="post" action="/doctor/cv-builder" class="card card-pad space-y-4">
          <h2 class="font-display font-bold text-lg text-navy-800">Edit sections</h2>
          <div><label class="label">Professional summary</label><textarea name="cv_summary" rows="3" class="textarea" placeholder="2-3 lines about your background, career break, and goals."><%= profile.cv_summary || '' %></textarea></div>
          <div><label class="label">Core skills</label><textarea name="cv_skills" rows="2" class="textarea" placeholder="Comma-separated: Antenatal care, Telemedicine, CBT..."><%= profile.cv_skills || '' %></textarea></div>
          <div><label class="label">Experience</label><textarea name="cv_experience" rows="4" class="textarea" placeholder="One role per line: Title — Hospital (years)"><%= profile.cv_experience || '' %></textarea></div>
          <div><label class="label">Education</label><textarea name="cv_education" rows="3" class="textarea"><%= profile.cv_education || '' %></textarea></div>
          <div><label class="label">Certifications</label><textarea name="cv_certifications" rows="2" class="textarea"><%= profile.cv_certifications || '' %></textarea></div>
          <button class="btn btn-primary">Save CV</button>
        </form>

        <div class="card card-pad bg-white">
          <div class="text-xs uppercase tracking-wider text-slate-500 font-bold mb-2">Live Preview</div>
          <div class="border border-slate-200 rounded-lg p-6">
            <div class="border-b border-slate-200 pb-4 mb-4">
              <div class="font-display font-extrabold text-2xl text-navy-800"><%= user.full_name %></div>
              <div class="text-sm text-slate-500"><%= profile.specialty %> • <%= profile.city %></div>
              <div class="text-xs text-slate-500 mt-1"><%= user.email %><% if (profile.languages) { %> • <%= profile.languages %><% } %></div>
            </div>
            <% if (profile.cv_summary) { %>
              <div class="mb-4">
                <div class="text-xs uppercase tracking-wider font-bold text-teal-700 mb-1">Summary</div>
                <p class="text-sm text-slate-700 whitespace-pre-line"><%= profile.cv_summary %></p>
              </div>
            <% } %>
            <% if (profile.cv_skills) { %>
              <div class="mb-4">
                <div class="text-xs uppercase tracking-wider font-bold text-teal-700 mb-1">Core Skills</div>
                <div class="flex flex-wrap gap-1">
                  <% profile.cv_skills.split(',').forEach(s => { %><span class="badge badge-lavender"><%= s.trim() %></span><% }) %>
                </div>
              </div>
            <% } %>
            <% if (profile.cv_experience) { %>
              <div class="mb-4">
                <div class="text-xs uppercase tracking-wider font-bold text-teal-700 mb-1">Experience</div>
                <p class="text-sm text-slate-700 whitespace-pre-line"><%= profile.cv_experience %></p>
              </div>
            <% } %>
            <% if (profile.cv_education) { %>
              <div class="mb-4">
                <div class="text-xs uppercase tracking-wider font-bold text-teal-700 mb-1">Education</div>
                <p class="text-sm text-slate-700 whitespace-pre-line"><%= profile.cv_education %></p>
              </div>
            <% } %>
            <% if (profile.cv_certifications) { %>
              <div>
                <div class="text-xs uppercase tracking-wider font-bold text-teal-700 mb-1">Certifications</div>
                <p class="text-sm text-slate-700 whitespace-pre-line"><%= profile.cv_certifications %></p>
              </div>
            <% } %>
          </div>
          <div class="mt-4 text-center"><button onclick="window.print()" class="btn btn-outline">Print / Save as PDF</button></div>
        </div>
      </div>
    </div>
  </div>
</section>

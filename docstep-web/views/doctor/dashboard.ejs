<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/doctor-side') %>

    <div class="space-y-6">
      <div>
        <h1 class="font-display font-extrabold text-3xl text-navy-800">Welcome back, <%= user.full_name.split(' ')[0] %>!</h1>
        <p class="text-slate-600">Here's your career-restart snapshot.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card card-pad"><div class="stat-lab">Appointments</div><div class="stat-num"><%= stats.appointments %></div></div>
        <div class="card card-pad"><div class="stat-lab">Verified Credentials</div><div class="stat-num"><%= stats.verifiedCredentials %></div></div>
        <div class="card card-pad"><div class="stat-lab">Upcoming Interviews</div><div class="stat-num"><%= stats.interviews %></div></div>
        <div class="card card-pad"><div class="stat-lab">Credentials</div><div class="stat-num"><%= stats.credentials %></div></div>
      </div>

      <% if (!profile.pmdc_number) { %>
        <div class="card card-pad border-amber-300 bg-amber-50/60" style="border-color:#FCD34D">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center">!</div>
            <div class="flex-1">
              <div class="font-semibold text-navy-800">Complete your profile to get matched</div>
              <p class="text-sm text-slate-600 mt-1">Add your PMDC number, specialty, and upload credentials to start receiving job matches.</p>
              <a href="/doctor/profile" class="btn btn-primary mt-3">Complete profile</a>
            </div>
          </div>
        </div>
      <% } %>

      <div class="card card-pad">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display font-bold text-xl text-navy-800">Upcoming interviews</h2>
        </div>
        <% if (interviews.length === 0) { %>
          <div class="text-sm text-slate-500">No interviews scheduled yet.</div>
        <% } else { %>
          <div class="space-y-3">
            <% interviews.forEach(i => { %>
              <div class="flex items-center justify-between border border-slate-100 rounded-lg p-3">
                <div>
                  <div class="font-semibold text-navy-800"><%= i.title %></div>
                  <div class="text-xs text-slate-500"><%= i.organization_name %> • <%= new Date(i.scheduled_at).toLocaleString() %></div>
                </div>
                <span class="badge badge-teal"><%= i.mode %></span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="card card-pad">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display font-bold text-xl text-navy-800">Recent appointments</h2>
          <a href="/doctor/appointments" class="text-sm text-teal-700 font-semibold">View all</a>
        </div>
        <% if (appointments.length === 0) { %>
          <div class="text-sm text-slate-500">You have no scheduled appointments yet.</div>
        <% } else { %>
          <div class="divide-y divide-slate-100">
            <% appointments.forEach(a => { %>
              <div class="py-3 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="font-semibold text-navy-800 truncate"><%= a.patient_name %></div>
                  <div class="text-xs text-slate-500"><%= new Date(a.date).toLocaleDateString() %> • <%= a.time_slot %></div>
                </div>
                <span class="badge badge-green">Scheduled</span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="card card-pad">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display font-bold text-xl text-navy-800">Recommended for you</h2>
          <a href="/opportunities" class="text-sm text-teal-700 font-semibold">More jobs →</a>
        </div>
        <div class="grid md:grid-cols-2 gap-3">
          <% recommended.forEach(j => { %>
            <a href="/jobs/<%= j.id %>" class="border border-slate-100 hover:border-teal-300 rounded-lg p-4 block transition">
              <div class="font-semibold text-navy-800"><%= j.title %></div>
              <div class="text-xs text-slate-500"><%= j.organization_name %> • <%= j.city %></div>
              <div class="flex gap-2 mt-2">
                <span class="badge badge-teal"><%= j.mode %></span>
                <span class="badge badge-lavender"><%= j.job_type %></span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>

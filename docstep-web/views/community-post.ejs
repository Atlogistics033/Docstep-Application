<!-- COMMUNITY POST -->
<section class="max-w-4xl mx-auto px-4 py-12">
  <a href="/community" class="text-sm text-slate-500 hover:text-teal-700">← Back to community</a>
  <div class="card card-pad mt-4">
    <div class="flex items-center justify-between mb-3">
      <span class="badge badge-lavender"><%= post.category %></span>
      <span class="text-xs text-slate-500"><%= new Date(post.created_at).toDateString() %></span>
    </div>
    <h1 class="font-display font-extrabold text-2xl md:text-3xl text-navy-800"><%= post.title %></h1>
    <div class="text-sm text-slate-500 mt-1">By <span class="font-semibold text-navy-800"><%= post.full_name %></span></div>
    <p class="text-slate-700 leading-relaxed mt-5 whitespace-pre-line"><%= post.content %></p>
  </div>

  <div class="mt-8">
    <h2 class="font-display font-bold text-xl text-navy-800 mb-4"><%= replies.length %> Replies</h2>
    <div class="space-y-3">
      <% replies.forEach(r => { %>
        <div class="card card-pad">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-teal-400 to-lavender-300 text-white flex items-center justify-center font-bold text-xs">
              <%= r.full_name.split(' ').map(p=>p[0]).slice(0,2).join('') %>
            </div>
            <div class="font-semibold text-sm text-navy-800"><%= r.full_name %></div>
            <div class="text-xs text-slate-500 ml-auto"><%= new Date(r.created_at).toDateString() %></div>
          </div>
          <p class="text-sm text-slate-700 whitespace-pre-line"><%= r.content %></p>
        </div>
      <% }) %>
      <% if (replies.length === 0) { %>
        <div class="text-sm text-slate-500 text-center py-4">No replies yet. Be the first to respond.</div>
      <% } %>
    </div>

    <div class="card card-pad mt-6">
      <h3 class="font-semibold text-navy-800 mb-3">Add a reply</h3>
      <% if (!user) { %>
        <p class="text-sm text-slate-600">Please <a href="/login" class="text-teal-700 font-semibold">login</a> to reply.</p>
      <% } else { %>
        <form method="post" action="/community/<%= post.id %>/reply" class="space-y-3">
          <textarea name="content" required rows="3" class="textarea" placeholder="Share your thoughts..."></textarea>
          <button class="btn btn-primary">Post reply</button>
        </form>
      <% } %>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-10">
  <!-- Welcome and Title -->
  <div class="mb-10">
    <div class="brand-pill mb-2">Admin Portal</div>
    <h1 class="font-display font-extrabold text-3xl md:text-4xl text-navy-800">Administrative Overview</h1>
    <p class="text-slate-600 mt-2">Manage doctor verifications, credential approvals, and check patient/employer support tickets.</p>
  </div>

  <!-- KPI Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
    <div class="card card-pad bg-gradient-to-br from-teal-50 to-white border-teal-100">
      <div class="stat-num text-teal-600"><%= stats.doctors %></div>
      <div class="stat-lab font-semibold mt-1">Total Doctors</div>
    </div>
    <div class="card card-pad bg-gradient-to-br from-lavender-50 to-white border-lavender-100">
      <div class="stat-num text-lavender-700"><%= stats.employers %></div>
      <div class="stat-lab font-semibold mt-1">Hiring Employers</div>
    </div>
    <div class="card card-pad bg-gradient-to-br from-slate-50 to-white">
      <div class="stat-num text-navy-700"><%= stats.jobs %></div>
      <div class="stat-lab font-semibold mt-1">Active Job Posts</div>
    </div>
    <div class="card card-pad bg-gradient-to-br from-teal-50/50 to-white">
      <div class="stat-num text-slate-800"><%= stats.stories %></div>
      <div class="stat-lab font-semibold mt-1">Success Stories</div>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Left Column: Pending Verifications -->
    <div class="lg:col-span-2 space-y-8">
      <!-- 1. Doctor PMDC Verifications -->
      <div class="card card-pad">
        <h2 class="font-display font-bold text-xl text-navy-800 mb-5 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          Pending Doctor PMDC Verifications
          <span class="ml-auto badge badge-amber"><%= unverifiedDocs.length %> pending</span>
        </h2>
        
        <% if (unverifiedDocs.length === 0) { %>
          <div class="text-center py-8 text-slate-500 text-sm">
            No doctors awaiting PMDC number verification.
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="border-b border-slate-100 text-slate-400 font-semibold uppercase text-xs">
                  <th class="py-3 px-2">Doctor</th>
                  <th class="py-3 px-2">PMDC Number</th>
                  <th class="py-3 px-2">Specialty</th>
                  <th class="py-3 px-2 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <% unverifiedDocs.forEach(d => { %>
                  <tr class="hover:bg-slate-50/50 transition">
                    <td class="py-3.5 px-2">
                      <div class="font-semibold text-navy-800"><%= d.full_name %></div>
                      <div class="text-xs text-slate-400"><%= d.email %></div>
                    </td>
                    <td class="py-3.5 px-2 font-mono text-slate-600"><%= d.pmdc_number || 'Not Provided' %></td>
                    <td class="py-3.5 px-2">
                      <span class="badge badge-teal"><%= d.specialty %></span>
                    </td>
                    <td class="py-3.5 px-2 text-right">
                      <% if (d.pmdc_number) { %>
                        <form method="post" action="/admin/verify-pmdc/<%= d.id %>" class="inline">
                          <button type="submit" class="btn btn-primary !py-1.5 !px-3 !text-xs">Verify</button>
                        </form>
                      <% } else { %>
                        <span class="text-xs text-slate-400 italic">No number</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- 2. Credential Document Approvals -->
      <div class="card card-pad">
        <h2 class="font-display font-bold text-xl text-navy-800 mb-5 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          Pending Credentials Documents
          <span class="ml-auto badge badge-amber"><%= unverifiedCreds.length %> pending</span>
        </h2>

        <% if (unverifiedCreds.length === 0) { %>
          <div class="text-center py-8 text-slate-500 text-sm">
            No credential documents awaiting verification.
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="border-b border-slate-100 text-slate-400 font-semibold uppercase text-xs">
                  <th class="py-3 px-2">Doctor</th>
                  <th class="py-3 px-2">Credential Details</th>
                  <th class="py-3 px-2">File</th>
                  <th class="py-3 px-2 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <% unverifiedCreds.forEach(c => { %>
                  <tr class="hover:bg-slate-50/50 transition">
                    <td class="py-3.5 px-2">
                      <div class="font-semibold text-navy-800"><%= c.doctor_name %></div>
                    </td>
                    <td class="py-3.5 px-2">
                      <div class="font-medium text-slate-700"><%= c.title %></div>
                      <div class="text-xs text-slate-400"><%= c.cred_type %></div>
                    </td>
                    <td class="py-3.5 px-2">
                      <% if (c.file_path) { %>
                        <a href="<%= c.file_path %>" target="_blank" class="text-teal-600 hover:text-teal-800 hover:underline flex items-center gap-1 font-semibold text-xs">
                          View PDF/Doc
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                        </a>
                      <% } else { %>
                        <span class="text-slate-400 text-xs italic">No file</span>
                      <% } %>
                    </td>
                    <td class="py-3.5 px-2 text-right flex items-center justify-end gap-2">
                      <form method="post" action="/admin/verify-credential/<%= c.id %>" class="inline">
                        <button type="submit" class="btn btn-primary !py-1.5 !px-3 !text-xs">Approve</button>
                      </form>
                      <form method="post" action="/admin/delete-credential/<%= c.id %>" class="inline">
                        <button type="submit" class="btn btn-outline border-red-200 text-red-600 hover:bg-red-50 hover:text-red-700 !py-1.5 !px-3 !text-xs">Reject</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Contact Us Tickets -->
    <div>
      <div class="card card-pad h-full">
        <h2 class="font-display font-bold text-xl text-navy-800 mb-5 flex items-center gap-2">
          <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          Support Tickets
        </h2>

        <% if (contacts.length === 0) { %>
          <div class="text-center py-12 text-slate-400 text-sm italic">
            No contact queries received.
          </div>
        <% } else { %>
          <div class="space-y-4 max-h-[600px] overflow-y-auto pr-2">
            <% contacts.forEach(msg => { %>
              <div class="border border-slate-100 rounded-lg p-4 bg-slate-50/50 hover:bg-white transition duration-200">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div class="font-bold text-navy-800 text-sm"><%= msg.name %></div>
                    <div class="text-slate-400 text-xs font-medium"><%= msg.email %></div>
                  </div>
                  <div class="text-[10px] text-slate-400 text-right"><%= new Date(msg.created_at).toLocaleDateString() %></div>
                </div>
                <div class="mt-2 text-xs border-t border-slate-100 pt-2">
                  <div class="font-bold text-slate-700"><%= msg.subject %></div>
                  <p class="text-slate-600 mt-1 whitespace-pre-wrap leading-relaxed"><%= msg.message %></p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

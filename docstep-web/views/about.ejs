<!-- ABOUT -->
<section class="hero-gradient">
  <div class="max-w-5xl mx-auto px-4 pt-16 pb-20 text-center">
    <div class="brand-pill mb-4">About DocStep</div>
    <h1 class="font-display font-extrabold text-4xl md:text-5xl text-navy-800 leading-tight">Bridging the gap between paused careers and the patients who need them.</h1>
    <p class="text-lg text-slate-600 mt-6 max-w-3xl mx-auto leading-relaxed">In Pakistan, a significant loss of valuable medical expertise occurs as many female doctors discontinue their practice after marriage or motherhood. At the same time, women and children — especially in under-served communities — face barriers to accessing care. DocStep was built to close that gap.</p>
  </div>
</section>

<!-- MISSION / VISION -->
<section class="max-w-7xl mx-auto px-4 py-20">
  <div class="grid lg:grid-cols-2 gap-10">
    <div class="card card-pad">
      <div class="badge badge-teal mb-3">Our Mission</div>
      <h2 class="font-display font-bold text-2xl text-navy-800 mb-3">Empower women doctors to return — sustainably</h2>
      <p class="text-slate-600 leading-relaxed">Provide flexible employment, training, mentorship, and telemedicine opportunities so that no medical career is lost to caregiving, marriage, or relocation.</p>
    </div>
    <div class="card card-pad">
      <div class="badge badge-lavender mb-3">Our Vision</div>
      <h2 class="font-display font-bold text-2xl text-navy-800 mb-3">A healthcare system that values every doctor's path</h2>
      <p class="text-slate-600 leading-relaxed">A Pakistan where every woman doctor can continue practising on her own terms — and every woman patient can access verified, private, compassionate care.</p>
    </div>
  </div>
</section>

<!-- SDG -->
<section class="section-soft py-20">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <div class="brand-pill mb-3">Aligned with Global Goals</div>
      <h2 class="font-display font-bold text-3xl text-navy-800">UN Sustainable Development Goals</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      <div class="card card-pad flex gap-5 items-start">
        <div class="w-16 h-16 rounded-xl bg-green-500 flex items-center justify-center text-white font-display font-extrabold text-2xl shrink-0">3</div>
        <div>
          <div class="font-display font-bold text-xl text-navy-800">Good Health & Well-being</div>
          <p class="text-sm text-slate-600 mt-2">Improves access to healthcare for women and children — especially in remote and conservative communities — through verified telemedicine and returning women doctors.</p>
        </div>
      </div>
      <div class="card card-pad flex gap-5 items-start">
        <div class="w-16 h-16 rounded-xl bg-orange-500 flex items-center justify-center text-white font-display font-extrabold text-2xl shrink-0">5</div>
        <div>
          <div class="font-display font-bold text-xl text-navy-800">Gender Equality</div>
          <p class="text-sm text-slate-600 mt-2">Empowers women medical professionals to continue contributing their expertise while balancing family responsibilities and career growth.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TEAM -->
<section class="max-w-7xl mx-auto px-4 py-20">
  <div class="text-center mb-12">
    <div class="brand-pill mb-3">The team behind DocStep</div>
    <h2 class="font-display font-bold text-3xl text-navy-800">Final Year Project — Group 16</h2>
    <p class="text-slate-600 mt-3">Department of Computer Science & Information Technology, Sir Syed University of Engineering & Technology, Karachi.</p>
  </div>
  <div class="grid md:grid-cols-3 gap-6">
    <% const team = [
      ['Syed Hasan Abdullah','2022F-BIT-044','Backend Developer + Database','from-teal-400 to-teal-600'],
      ['Syed Haider Raza Naqvi','2022F-BIT-053','Research + Testing + Documentation','from-lavender-300 to-lavender-500'],
      ['M. Arham Akhtar','2022F-BIT-014','Frontend Developer + UI/UX','from-navy-700 to-navy-800']
    ]; %>
    <% team.forEach(m => { %>
      <div class="card card-pad text-center">
        <div class="w-24 h-24 rounded-full mx-auto mb-4 bg-gradient-to-br <%= m[3] %> flex items-center justify-center text-white font-display font-extrabold text-3xl">
          <%= m[0].split(' ').map(p => p[0]).slice(0,2).join('') %>
        </div>
        <div class="font-display font-bold text-lg text-navy-800"><%= m[0] %></div>
        <div class="text-xs text-slate-500 mt-1"><%= m[1] %></div>
        <div class="text-sm text-teal-700 font-semibold mt-3"><%= m[2] %></div>
      </div>
    <% }) %>
  </div>
  <div class="mt-12 max-w-2xl mx-auto card card-pad text-center bg-gradient-to-br from-lavender-50 to-teal-50">
    <div class="text-xs uppercase tracking-wider text-lavender-700 font-bold">Project Supervisor</div>
    <div class="font-display font-bold text-2xl text-navy-800 mt-1">Dr. Waleej Haider</div>
    <div class="text-sm text-slate-600">Associate Professor, SSUET</div>
  </div>
</section>

<!-- HOW WE COMPARE -->
<section class="section-soft py-20">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-10">
      <div class="brand-pill mb-3">Why DocStep</div>
      <h2 class="font-display font-bold text-3xl text-navy-800">How we compare</h2>
    </div>
    <div class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-navy-800 text-white">
          <tr>
            <th class="text-left p-4">Feature</th>
            <th class="p-4">Sehat Kahani</th>
            <th class="p-4">Oladoc</th>
            <th class="p-4">Marham</th>
            <th class="p-4 bg-teal-600">DocStep</th>
          </tr>
        </thead>
        <tbody class="text-slate-700">
          <% const rows = [
            ['Focus group','General public','General public','General public','Women doctors & patients'],
            ['Doctor pool','Mixed gender','Mixed gender','Mixed gender','Exclusively women doctors'],
            ['Privacy for patients','Medium','Medium','Medium','High — women-only interface'],
            ['Career-return support','None','None','None','Returnship + mentorship + courses'],
            ['Psychotherapy support','Limited','Limited','Limited','Strong focus'],
            ['Community outreach','None','Minimal','Moderate','NGOs / CSR partnerships'],
          ]; %>
          <% rows.forEach((r,i) => { %>
            <tr class="border-t border-slate-100 <%= i%2===0 ? 'bg-slate-50/40' : '' %>">
              <td class="p-4 font-semibold text-navy-800"><%= r[0] %></td>
              <td class="p-4 text-center"><%= r[1] %></td>
              <td class="p-4 text-center"><%= r[2] %></td>
              <td class="p-4 text-center"><%= r[3] %></td>
              <td class="p-4 text-center bg-teal-50 font-semibold text-teal-800"><%= r[4] %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- SUGGEST BEST DOCTOR SEARCH ENGINE -->
<div class="fade-in text-left">
  <!-- Hero Section -->
  <section class="hero-gradient py-12 md:py-16 bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <div class="brand-pill bg-teal-50 text-teal-800 border border-teal-100 px-4 py-1.5 rounded-full inline-flex items-center gap-2 mb-4 text-sm font-semibold">
        <svg class="w-4 h-4 text-teal-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Karachi Clinic Locator
      </div>
      <h1 class="font-display font-extrabold text-3xl md:text-5xl text-navy-800 leading-tight">
        Suggest Best Doctor
      </h1>
      <p class="text-slate-600 mt-3 max-w-2xl mx-auto text-base md:text-lg">
        Find top-rated women doctors by their physical clinic/hospital address and location in Karachi.
      </p>
    </div>
  </section>

  <!-- Filter & Search Section -->
  <section class="max-w-7xl mx-auto px-4 -mt-8 relative z-30">
    <div class="card card-pad bg-white shadow-xl shadow-navy-800/5 border border-slate-100 rounded-3xl p-6">
      <form action="/suggest-best-doctor" method="GET" class="grid md:grid-cols-[1fr_auto] gap-4 items-end">
        <div class="space-y-1">
          <label class="block text-sm font-bold text-navy-800 mb-1.5 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
            Filter by Clinic Location / Area
          </label>
          <select name="location" class="select border-slate-300 h-[46px] rounded-xl focus:border-teal-500 focus:ring-2 focus:ring-teal-100 text-slate-800 font-semibold" onchange="this.form.submit()">
            <option value="">All Locations / Areas</option>
            <% locations.forEach(loc => { %>
              <option value="<%= loc %>" <%= selectedLocation === loc ? 'selected' : '' %>><%= loc %></option>
            <% }) %>
          </select>
        </div>
        <div class="flex gap-2">
          <% if (selectedLocation) { %>
            <a href="/suggest-best-doctor" class="btn btn-outline border-slate-300 text-slate-600 h-[46px] flex items-center px-4 rounded-xl font-semibold hover:bg-slate-50 transition-colors">
              Reset Filters
            </a>
          <% } %>
          <button type="submit" class="btn btn-primary h-[46px] px-6 rounded-xl flex items-center justify-center font-bold shadow-lg shadow-teal-500/20">
            Apply Filter
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Doctor List Section -->
  <section class="max-w-7xl mx-auto px-4 py-12">
    <% if (!selectedLocation) { %>
      <!-- Prompt to filter -->
      <div class="card card-pad bg-white border border-dashed border-slate-200 rounded-3xl text-center py-16 max-w-xl mx-auto">
        <div class="w-16 h-16 bg-teal-50 border border-teal-100 rounded-full flex items-center justify-center text-teal-600 mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-navy-800 mb-1">Select a Location</h3>
        <p class="text-slate-500 text-sm max-w-sm mx-auto">
          Please choose a clinic location or area from the dropdown above to view suggested doctors.
        </p>
      </div>
    <% } else if (doctors.length === 0) { %>
      <!-- Empty State -->
      <div class="card card-pad bg-white border border-dashed border-slate-200 rounded-3xl text-center py-16 max-w-xl mx-auto">
        <div class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center text-slate-400 mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-navy-800 mb-1">No Doctors Found</h3>
        <p class="text-slate-500 text-sm max-w-sm mx-auto mb-6">
          We couldn't find any registered doctors practicing at '<%= selectedLocation %>' right now. Please select another location.
        </p>
        <a href="/suggest-best-doctor" class="btn btn-teal text-white bg-teal-600 hover:bg-teal-700 font-bold px-6 py-2.5 rounded-xl transition-colors">
          Browse All Locations
        </a>
      </div>
    <% } else { %>
      <!-- Grid Container -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% doctors.forEach(doc => { %>
          <div class="card bg-white border border-slate-100 rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-teal-400 relative overflow-hidden group">
            
            <!-- Left Glow Indicator -->
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-teal-500 to-teal-700 opacity-80 rounded-l-2xl group-hover:w-1.5 transition-all"></div>

            <div>
              <!-- Header Row -->
              <div class="flex items-start justify-between gap-2 mb-3">
                <div>
                  <h3 class="font-display font-extrabold text-navy-800 text-lg group-hover:text-teal-700 transition-colors">
                    <%= doc.full_name.startsWith('Dr.') ? doc.full_name : 'Dr. ' + doc.full_name %>
                  </h3>
                  <div class="text-xs text-slate-500 font-semibold mt-0.5"><%= doc.qualifications %></div>
                </div>
                <span class="badge badge-teal shrink-0 py-1 px-3 text-xs font-bold rounded-lg shadow-sm"><%= doc.specialty %></span>
              </div>

              <!-- Experience & Bio -->
              <div class="flex items-center gap-2 mb-4">
                <span class="badge badge-navy bg-navy-800/5 text-navy-800 py-0.5 px-2 rounded text-xs font-semibold">
                  <%= doc.experience_years %> Years Exp
                </span>
                <% if (doc.pmdc_verified === 1) { %>
                  <span class="badge badge-green bg-green-50 text-green-700 py-0.5 px-2 rounded text-xs font-semibold flex items-center gap-0.5">
                    <svg class="w-3 h-3 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M6.267 3.455a.75.75 0 00-.708.522L4.547 7.02H2.25a.75.75 0 000 1.5h2.645l.95 2.85c.108.324.414.54.757.54h2.298l.95 2.85a.75.75 0 001.417-.008l1.716-5.15h2.176a.75.75 0 000-1.5h-2.564a.75.75 0 00-.708.522L12.453 10.98h-1.637l-1.715-5.15a.75.75 0 00-.708-.522h-2.126z" clip-rule="evenodd"/>
                    </svg>
                    PMDC Verified
                  </span>
                <% } %>
              </div>

              <p class="text-slate-600 text-sm line-clamp-3 mb-6 leading-relaxed">
                <%= doc.bio || 'No professional bio provided yet. Rest assured, this medical professional is registered and verified on DocStep.' %>
              </p>

              <div class="divider my-4 bg-slate-100"></div>

              <!-- Clinic Information -->
              <div class="space-y-2.5 mb-6">
                <div class="flex items-start gap-2.5">
                  <div class="w-5 h-5 bg-teal-50 rounded-md flex items-center justify-center shrink-0 mt-0.5 text-teal-600">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 leading-none">Clinic / Hospital</div>
                    <div class="text-sm font-semibold text-navy-800 mt-0.5">
                      <%= doc.clinic_name || 'Not Available' %>
                    </div>
                  </div>
                </div>

                <div class="flex items-start gap-2.5">
                  <div class="w-5 h-5 bg-teal-50 rounded-md flex items-center justify-center shrink-0 mt-0.5 text-teal-600">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 leading-none">Location / Area</div>
                    <div class="text-sm font-semibold text-teal-700 mt-0.5">
                      <%= doc.clinic_address || 'Not Available' %>
                    </div>
                  </div>
                </div>

                <% if (doc.clinic_hospital_address) { %>
                  <div class="flex items-start gap-2.5">
                    <div class="w-5 h-5 bg-teal-50 rounded-md flex items-center justify-center shrink-0 mt-0.5 text-teal-600">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      </svg>
                    </div>
                    <div>
                      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 leading-none">Clinic / Hospital Address</div>
                      <div class="text-sm font-semibold text-navy-800 mt-0.5 animate-fade-in">
                        <%= doc.clinic_hospital_address %>
                      </div>
                    </div>
                  </div>
                <% } %>

                <% if (doc.phone) { %>
                  <div class="flex items-start gap-2.5">
                    <div class="w-5 h-5 bg-teal-50 rounded-md flex items-center justify-center shrink-0 mt-0.5 text-teal-600">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                      </svg>
                    </div>
                    <div>
                      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 leading-none">Phone Number</div>
                      <div class="text-sm font-semibold text-navy-800 mt-0.5">
                        <%= doc.phone %>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Footer Details & Call to Action -->
            <div class="mt-auto">
              <div class="bg-slate-50 rounded-xl p-3 flex items-center justify-between gap-2 mb-4 border border-slate-100">
                <div>
                  <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 leading-none">Hourly Fees</div>
                  <div class="text-sm font-extrabold text-navy-800 mt-1">
                    <%= doc.hourly_rate > 0 ? doc.hourly_rate + ' PKR' : 'Consultation Fee' %>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 leading-none">Availability</div>
                  <div class="text-xs font-semibold text-slate-600 mt-1">
                    <%= doc.availability || 'Flexible' %>
                  </div>
                </div>
              </div>

              <a href="/book-appointment?doctor_id=<%= doc.id %>" class="btn btn-primary w-full justify-center py-2.5 rounded-xl font-bold transition-all shadow-md group-hover:shadow-teal-500/10">
                Book Consultation
                <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

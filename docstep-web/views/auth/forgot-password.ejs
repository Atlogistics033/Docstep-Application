<section class="hero-gradient min-h-[80vh] flex items-center py-12">
  <div class="max-w-md mx-auto px-4 w-full">
    <div class="text-center mb-6">
      <a href="/" class="logo-mark inline-flex justify-center mb-4" style="gap: 0.8rem;">
        <img src="/images/logo.png" alt="DocStep" style="height: 52px;" />
        <div class="wordmark" style="font-size: 1.95rem;">Doc<span>Step</span></div>
      </a>
      <h1 class="font-display font-extrabold text-3xl text-navy-800">Forgot Password</h1>
      <p class="text-slate-600 mt-2 text-sm">Enter your email and we'll help you reset your password.</p>
    </div>

    <div class="card card-pad bg-white shadow-sm border border-slate-100 rounded-2xl p-6">
      <% if (error) { %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl">
          <%= error %>
        </div>
      <% } %>

      <% if (resetLink) { %>
        <div class="mb-6 p-4 bg-teal-50 border border-teal-200 text-teal-800 rounded-xl text-center">
          <p class="font-semibold text-sm mb-2">Password reset link generated!</p>
          <p class="text-xs text-slate-500 mb-3">For demo & testing purposes, you can click the button below directly to set your new password:</p>
          <a href="<%= resetLink %>" class="btn btn-primary w-full justify-center text-sm py-2">
            Reset Password Now
          </a>
        </div>
      <% } %>

      <form method="post" action="/forgot-password" class="space-y-4">
        <div>
          <label class="label block text-sm font-semibold text-slate-700 mb-1">Email Address</label>
          <input type="email" name="email" required placeholder="name@example.com" class="input w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
        </div>
        <button class="btn btn-primary w-full justify-center py-2 px-4 rounded-xl font-semibold text-white bg-teal-600 hover:bg-teal-700 transition-colors">Send Reset Link</button>
      </form>

      <div class="text-center text-sm text-slate-500 mt-5 pt-4 border-t border-slate-100">
        Remember your password? <a href="/login" class="text-teal-700 font-semibold hover:underline">Back to Login</a>
      </div>
    </div>
  </div>
</section>

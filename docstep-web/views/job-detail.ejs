<!-- JOB DETAIL -->
<section class="hero-gradient py-12">
  <div class="max-w-5xl mx-auto px-4">
    <a href="/opportunities" class="text-sm text-slate-500 hover:text-teal-700">← Back to opportunities</a>
    <h1 class="font-display font-extrabold text-3xl md:text-4xl text-navy-800 mt-4"><%= job.title %></h1>
    <div class="flex flex-wrap items-center gap-3 mt-3 text-slate-600">
      <span class="font-semibold text-navy-800"><%= job.organization_name %></span>
      <span>•</span>
      <span><%= job.city %></span>
      <span>•</span>
      <span class="badge badge-teal"><%= job.mode %></span>
      <span class="badge badge-lavender"><%= job.specialty %></span>
      <span class="badge badge-navy"><%= job.job_type %></span>
    </div>
  </div>
</section>

<section class="max-w-5xl mx-auto px-4 py-12 grid lg:grid-cols-3 gap-8">
  <div class="lg:col-span-2 space-y-6">
    <div class="card card-pad">
      <h2 class="font-display font-bold text-xl text-navy-800 mb-3">About the role</h2>
      <p class="text-slate-700 leading-relaxed whitespace-pre-line"><%= job.description %></p>
    </div>
    <div class="card card-pad">
      <h2 class="font-display font-bold text-xl text-navy-800 mb-3">Requirements</h2>
      <p class="text-slate-700 leading-relaxed whitespace-pre-line"><%= job.requirements %></p>
    </div>
    <div class="card card-pad">
      <h2 class="font-display font-bold text-xl text-navy-800 mb-3">About <%= job.organization_name %></h2>
      <div class="text-sm text-slate-500 mb-2"><%= job.organization_type %><% if (job.website) { %> • <a href="<%= job.website %>" class="text-teal-700">Website</a><% } %></div>
      <p class="text-slate-700 leading-relaxed"><%= job.about %></p>
    </div>
  </div>

  <aside class="space-y-4">
    <div class="card card-pad">
      <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Compensation</div>
      <div class="font-display font-bold text-xl text-teal-700 mt-1"><%= job.salary_range %></div>
      <div class="divider my-4"></div>
      <% if (!user) { %>
        <a href="/login" class="btn btn-primary w-full justify-center">Login to apply</a>
        <a href="/register?role=doctor" class="btn btn-outline w-full justify-center mt-2">Create doctor account</a>
      <% } else if (user.role !== 'doctor') { %>
        <div class="text-sm text-slate-500 text-center">Only doctor accounts can apply.</div>
      <% } else if (applied) { %>
        <div class="badge badge-green w-full justify-center py-2">✓ Application submitted</div>
        <a href="/doctor/applications" class="btn btn-outline w-full justify-center mt-3">View my applications</a>
      <% } else { %>
        <form method="post" action="/doctor/apply/<%= job.id %>" class="space-y-3">
          <label class="label">Cover letter (optional)</label>
          <textarea name="cover_letter" rows="4" class="textarea" placeholder="Tell the employer why you're a great fit..."></textarea>
          <button class="btn btn-primary w-full justify-center">Apply now</button>
        </form>
      <% } %>
    </div>
    <% if (related.length) { %>
    <div class="card card-pad">
      <div class="font-semibold text-navy-800 mb-3">Similar roles</div>
      <div class="space-y-3">
        <% related.forEach(r => { %>
          <a href="/jobs/<%= r.id %>" class="block text-sm hover:text-teal-700">
            <div class="font-semibold text-navy-800"><%= r.title %></div>
            <div class="text-xs text-slate-500"><%= r.city %> • <%= r.mode %></div>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>
  </aside>
</section>

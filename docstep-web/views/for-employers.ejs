<!-- FOR EMPLOYERS -->
<section class="hero-gradient">
  <div class="max-w-7xl mx-auto px-4 pt-16 pb-20 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <div class="brand-pill mb-4">For Employers</div>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-navy-800 leading-tight">Hire verified women doctors — <span class="text-lavender-700">on flexible terms.</span></h1>
      <p class="text-lg text-slate-600 mt-5 leading-relaxed">Tap into a vetted pool of returning gynecologists, pediatricians, psychiatrists, and GPs ready for remote, hybrid, and part-time roles.</p>
      <div class="flex gap-3 mt-7">
        <a href="/register?role=employer" class="btn btn-lavender">Post your first job</a>
        <a href="/contact" class="btn btn-outline">Talk to our team</a>
      </div>
    </div>
    <div class="space-y-3">
      <div class="card card-pad bg-white">
        <div class="text-xs uppercase tracking-wider text-lavender-700 font-bold">Step 1</div>
        <div class="font-display font-bold text-lg text-navy-800 mt-1">Post a role in minutes</div>
        <div class="text-sm text-slate-600 mt-1">Specialty, mode, salary, requirements — done in 60 seconds.</div>
      </div>
      <div class="card card-pad bg-white">
        <div class="text-xs uppercase tracking-wider text-teal-700 font-bold">Step 2</div>
        <div class="font-display font-bold text-lg text-navy-800 mt-1">Browse verified candidates</div>
        <div class="text-sm text-slate-600 mt-1">PMDC-verified profiles, with CVs and credentials at your fingertips.</div>
      </div>
      <div class="card card-pad bg-white">
        <div class="text-xs uppercase tracking-wider text-navy-800 font-bold">Step 3</div>
        <div class="font-display font-bold text-lg text-navy-800 mt-1">Interview & hire</div>
        <div class="text-sm text-slate-600 mt-1">Schedule interviews, track applications, and hire — all from your dashboard.</div>
      </div>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-20">
  <div class="text-center mb-12">
    <div class="brand-pill mb-3">Why hire on DocStep</div>
    <h2 class="font-display font-bold text-3xl text-navy-800">A pool you can't reach anywhere else</h2>
  </div>
  <div class="grid md:grid-cols-3 gap-5">
    <% const ben = [
      ['PMDC-verified only','We verify every doctor against their PMDC registration before publishing their profile.'],
      ['Flexible-first talent','Every doctor on DocStep is open to remote, hybrid, or part-time arrangements.'],
      ['Highly experienced','Average 5+ years of clinical experience across gynae, peds, psychiatry, and GP.'],
      ['Faster matching','Smart filters and AI matching surface only the most relevant candidates.'],
      ['Diversity-positive hiring','Strengthen your gender balance with returning women medical leaders.'],
      ['CSR-aligned partnerships','Co-design returnship programs and women\'s-health initiatives with us.']
    ]; %>
    <% ben.forEach(b => { %>
      <div class="card card-pad">
        <div class="w-10 h-10 rounded-lg bg-lavender-100 text-lavender-700 flex items-center justify-center mb-3">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </div>
        <div class="font-semibold text-navy-800 mb-1"><%= b[0] %></div>
        <div class="text-sm text-slate-600"><%= b[1] %></div>
      </div>
    <% }) %>
  </div>
</section>

<section class="section-lavender py-20">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-10">
      <div class="brand-pill mb-3">Pricing — coming soon</div>
      <h2 class="font-display font-bold text-3xl text-navy-800">Simple, transparent plans</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="card card-pad bg-white">
        <div class="badge badge-gray mb-2">Free</div>
        <div class="stat-num">PKR 0</div>
        <div class="text-sm text-slate-500">Post up to 1 job. Browse public profiles.</div>
        <ul class="text-sm text-slate-600 mt-4 space-y-2">
          <li>✓ 1 active job posting</li>
          <li>✓ Basic candidate search</li>
          <li>✓ Email notifications</li>
        </ul>
      </div>
      <div class="card card-pad bg-white border-teal-500" style="border-color:#2BA3A0;border-width:2px">
        <div class="badge badge-teal mb-2">Growth</div>
        <div class="stat-num">PKR 9,900<span class="text-sm font-medium">/mo</span></div>
        <div class="text-sm text-slate-500">Most popular for clinics & telehealth.</div>
        <ul class="text-sm text-slate-600 mt-4 space-y-2">
          <li>✓ 10 active job postings</li>
          <li>✓ Full candidate search & filters</li>
          <li>✓ Interview scheduling tools</li>
          <li>✓ Featured listing badges</li>
        </ul>
      </div>
      <div class="card card-pad bg-white">
        <div class="badge badge-lavender mb-2">Enterprise</div>
        <div class="stat-num">Custom</div>
        <div class="text-sm text-slate-500">Hospital networks & telehealth platforms.</div>
        <ul class="text-sm text-slate-600 mt-4 space-y-2">
          <li>✓ Unlimited postings & seats</li>
          <li>✓ Returnship program co-design</li>
          <li>✓ API & ATS integrations</li>
          <li>✓ Dedicated success manager</li>
        </ul>
      </div>
    </div>
  </div>
</section>

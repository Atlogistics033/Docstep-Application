<!-- COMMUNITY -->
<section class="hero-gradient">
  <div class="max-w-6xl mx-auto px-4 pt-14 pb-10">
    <div class="brand-pill mb-3">Community</div>
    <h1 class="font-display font-extrabold text-3xl md:text-5xl text-navy-800">Conversations that support your return</h1>
    <p class="text-slate-600 mt-3 max-w-2xl">A safe peer space for women doctors — share questions, advice, and stories.</p>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 py-12 grid lg:grid-cols-3 gap-8">
  <div class="lg:col-span-2 space-y-4">
    <% if (posts.length === 0) { %>
      <div class="card card-pad text-center text-slate-500">No posts yet. Be the first to start a thread.</div>
    <% } %>
    <% posts.forEach(p => { %>
      <a href="/community/<%= p.id %>" class="card card-pad block">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="font-display font-bold text-lg text-navy-800"><%= p.title %></h3>
            <div class="text-xs text-slate-500 mt-1">By <span class="font-semibold text-navy-800"><%= p.full_name %></span> • <%= new Date(p.created_at).toDateString() %></div>
          </div>
          <span class="badge badge-lavender"><%= p.category %></span>
        </div>
        <p class="text-sm text-slate-600 mt-3 line-clamp-2"><%= p.content %></p>
        <div class="flex items-center gap-4 mt-4 text-xs text-slate-500">
          <span>💬 <%= p.reply_count %> replies</span>
        </div>
      </a>
    <% }) %>
  </div>

  <aside class="space-y-4">
    <div class="card card-pad">
      <h3 class="font-display font-bold text-lg text-navy-800 mb-2">Start a new thread</h3>
      <% if (!user) { %>
        <p class="text-sm text-slate-600 mb-3">Login or create an account to post.</p>
        <a href="/login" class="btn btn-primary w-full justify-center">Login</a>
      <% } else { %>
        <form method="post" action="/community/new" class="space-y-3">
          <input name="title" required class="input" placeholder="Title of your post" />
          <select name="category" class="select">
            <option>Returning to Practice</option>
            <option>Telemedicine</option>
            <option>Mental Health</option>
            <option>Returnship</option>
            <option>Licensing</option>
            <option>General</option>
          </select>
          <textarea name="content" required rows="4" class="textarea" placeholder="Share your question or story..."></textarea>
          <button class="btn btn-primary w-full justify-center">Post</button>
        </form>
      <% } %>
    </div>
    <div class="card card-pad bg-gradient-to-br from-lavender-50 to-teal-50">
      <h3 class="font-display font-bold text-navy-800 mb-2">Community guidelines</h3>
      <ul class="text-sm text-slate-700 space-y-1">
        <li>• Be kind and respectful.</li>
        <li>• Keep patient information confidential.</li>
        <li>• No promotional or spam content.</li>
        <li>• Women-only space — moderated for safety.</li>
      </ul>
    </div>
  </aside>
</section>

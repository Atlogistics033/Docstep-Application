<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/employer-side') %>

    <div>
      <h1 class="font-display font-extrabold text-3xl text-navy-800 mb-2"><%= job ? 'Edit Job' : 'Post a New Job' %></h1>
      <p class="text-slate-600 mb-6">Fill in the details — your role will go live immediately.</p>

      <form method="post" action="<%= job ? '/employer/jobs/'+job.id+'/edit' : '/employer/jobs/new' %>" class="card card-pad space-y-4 max-w-3xl">
        <div><label class="label">Job title</label><input name="title" required class="input" value="<%= job ? job.title : '' %>" placeholder="e.g. Remote Pediatrician — Evening shift" /></div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="label">Specialty</label>
            <select name="specialty" class="select">
              <% ['Gynecology','Pediatrics','Psychiatry','Dermatology','General Practice','Internal Medicine','Cardiology'].forEach(s => { %>
                <option <%= job && job.specialty===s?'selected':'' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="label">Job type</label>
            <select name="job_type" class="select">
              <% ['Full-time','Part-time','Contract','Returnship'].forEach(t => { %>
                <option <%= job && job.job_type===t?'selected':'' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="label">Mode</label>
            <select name="mode" class="select">
              <% ['Remote','Hybrid','Onsite'].forEach(m => { %>
                <option <%= job && job.mode===m?'selected':'' %>><%= m %></option>
              <% }) %>
            </select>
          </div>
          <div><label class="label">City</label><input name="city" class="input" value="<%= job ? job.city : '' %>" placeholder="e.g. Karachi or 'Anywhere in Pakistan'" /></div>
        </div>
        <div><label class="label">Salary range</label><input name="salary_range" class="input" value="<%= job ? job.salary_range : '' %>" placeholder="e.g. PKR 80,000 - 150,000 / month" /></div>
        <div><label class="label">Description</label><textarea name="description" required rows="5" class="textarea"><%= job ? job.description : '' %></textarea></div>
        <div><label class="label">Requirements</label><textarea name="requirements" required rows="3" class="textarea"><%= job ? job.requirements : '' %></textarea></div>
        <% if (job) { %>
          <div>
            <label class="label">Status</label>
            <select name="status" class="select">
              <option value="open" <%= job.status==='open'?'selected':'' %>>Open</option>
              <option value="closed" <%= job.status==='closed'?'selected':'' %>>Closed</option>
            </select>
          </div>
        <% } %>
        <div class="flex gap-3">
          <button class="btn btn-primary"><%= job ? 'Save changes' : 'Post job' %></button>
          <a href="/employer/jobs" class="btn btn-ghost">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/employer-side') %>

    <div class="space-y-6">
      <div class="flex items-end justify-between">
        <div>
          <h1 class="font-display font-extrabold text-3xl text-navy-800"><%= profile.organization_name %></h1>
          <p class="text-slate-600">Your hiring at a glance.</p>
        </div>
        <a href="/employer/jobs/new" class="btn btn-primary hidden md:inline-flex">+ Post a job</a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card card-pad"><div class="stat-lab">Open jobs</div><div class="stat-num"><%= stats.open %></div></div>
        <div class="card card-pad"><div class="stat-lab">Total postings</div><div class="stat-num"><%= stats.jobs %></div></div>
        <div class="card card-pad"><div class="stat-lab">Appointments</div><div class="stat-num"><%= stats.appointments %></div></div>
        <div class="card card-pad"><div class="stat-lab">Upcoming interviews</div><div class="stat-num"><%= stats.interviews %></div></div>
      </div>

      <div class="card card-pad">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display font-bold text-xl text-navy-800">Recent appointments</h2>
          <a href="/employer/appointments" class="text-sm text-teal-700 font-semibold">View all</a>
        </div>
        <% if (appointments.length === 0) { %>
          <div class="text-sm text-slate-500">No appointments scheduled yet.</div>
        <% } else { %>
          <div class="divide-y divide-slate-100">
            <% appointments.forEach(a => { %>
              <div class="py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
                <div>
                  <div class="font-semibold text-navy-800"><%= a.patient_name %></div>
                  <div class="text-xs text-slate-500">Consultation with <span class="font-semibold text-navy-700">Dr. <%= a.doctor_name %></span> • <%= a.primary_specialty %> • <%= new Date(a.date).toLocaleDateString() %> • <%= a.time_slot %></div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="badge badge-green">Scheduled</span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="card card-pad">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display font-bold text-xl text-navy-800">Upcoming interviews</h2>
        </div>
        <% if (interviews.length === 0) { %>
          <div class="text-sm text-slate-500">No interviews scheduled.</div>
        <% } else { %>
          <div class="space-y-2">
            <% interviews.forEach(i => { %>
              <div class="border border-slate-100 rounded-lg p-3 flex items-center justify-between">
                <div>
                  <div class="font-semibold text-navy-800"><%= i.doctor_name %> — <%= i.title %></div>
                  <div class="text-xs text-slate-500"><%= new Date(i.scheduled_at).toLocaleString() %> • <%= i.mode %></div>
                </div>
                <span class="badge badge-teal"><%= i.status %></span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="card card-pad">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display font-bold text-xl text-navy-800">My jobs</h2>
          <a href="/employer/jobs" class="text-sm text-teal-700 font-semibold">Manage</a>
        </div>
        <div class="grid md:grid-cols-2 gap-3">
          <% jobs.slice(0,4).forEach(j => { %>
            <div class="border border-slate-100 rounded-lg p-4">
              <div class="flex items-start justify-between">
                <div>
                  <div class="font-semibold text-navy-800"><%= j.title %></div>
                  <div class="text-xs text-slate-500"><%= j.city %> • <%= j.mode %></div>
                </div>
                <span class="badge <%= j.status==='open'?'badge-green':'badge-gray' %>"><%= j.status %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>

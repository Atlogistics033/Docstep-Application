<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/employer-side') %>

    <div>
      <h1 class="font-display font-extrabold text-3xl text-navy-800 mb-2">Organization Profile</h1>
      <p class="text-slate-600 mb-6">This is what candidates see when they view your jobs.</p>

      <form method="post" action="/employer/profile" class="card card-pad space-y-4 max-w-3xl">
        <div class="grid md:grid-cols-2 gap-4">
          <div><label class="label">Your name (HR contact)</label><input name="full_name" required class="input" value="<%= user.full_name %>" /></div>
          <div><label class="label">Phone</label><input name="phone" class="input" /></div>
        </div>
        <div><label class="label">Organization name</label><input name="organization_name" required class="input" value="<%= profile.organization_name %>" /></div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="label">Type</label>
            <select name="organization_type" class="select">
              <% ['Hospital','Clinic','Telemedicine Platform','Hospital Network','NGO','Other'].forEach(t => { %>
                <option <%= profile.organization_type===t?'selected':'' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
          <div><label class="label">City</label><input name="city" class="input" value="<%= profile.city || '' %>" /></div>
        </div>
        <div><label class="label">Website</label><input name="website" class="input" value="<%= profile.website || '' %>" placeholder="https://..." /></div>
        <div><label class="label">About your organization</label><textarea name="about" rows="4" class="textarea"><%= profile.about || '' %></textarea></div>
        <button class="btn btn-primary">Save profile</button>
      </form>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/employer-side') %>

    <div>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="font-display font-extrabold text-3xl text-navy-800">My Job Postings</h1>
          <p class="text-slate-600">Manage your open and closed roles.</p>
        </div>
        <a href="/employer/jobs/new" class="btn btn-primary">+ Post a job</a>
      </div>

      <div class="card overflow-hidden">
        <% if (jobs.length === 0) { %>
          <div class="p-8 text-center text-slate-500">No jobs yet. <a href="/employer/jobs/new" class="text-teal-700 font-semibold">Post your first job</a>.</div>
        <% } else { %>
          <table class="w-full text-sm">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
              <tr>
                <th class="p-4 text-left">Title</th>
                <th class="p-4">Mode</th>
                <th class="p-4">Specialty</th>
                <th class="p-4 text-center">Applications</th>
                <th class="p-4">Status</th>
                <th class="p-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% jobs.forEach(j => { %>
                <tr>
                  <td class="p-4">
                    <a href="/jobs/<%= j.id %>" class="font-semibold text-navy-800 hover:text-teal-700"><%= j.title %></a>
                    <div class="text-xs text-slate-500"><%= j.city %> • <%= j.salary_range %></div>
                  </td>
                  <td class="p-4 text-center"><span class="badge badge-teal"><%= j.mode %></span></td>
                  <td class="p-4 text-center"><span class="badge badge-lavender"><%= j.specialty %></span></td>
                  <td class="p-4 text-center font-semibold text-navy-800"><%= j.app_count %></td>
                  <td class="p-4 text-center"><span class="badge <%= j.status==='open'?'badge-green':'badge-gray' %>"><%= j.status %></span></td>
                  <td class="p-4 text-right">
                    <a href="/employer/jobs/<%= j.id %>/edit" class="text-teal-700 font-semibold text-xs">Edit</a>
                    <form method="post" action="/employer/jobs/<%= j.id %>/delete" class="inline ml-2" onsubmit="return confirm('Delete this job?')">
                      <button class="text-red-600 font-semibold text-xs">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
</section>

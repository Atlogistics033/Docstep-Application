<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="grid lg:grid-cols-[260px_1fr] gap-6">
    <%- include('../partials/employer-side') %>

    <div>
      <a href="/employer/candidates" class="text-sm text-slate-500 hover:text-teal-700">← Back to candidates</a>
      <div class="card card-pad mt-3">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <div class="flex items-center gap-4">
            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-teal-400 to-lavender-300 flex items-center justify-center text-white font-bold text-2xl">
              <%= cand.full_name.split(' ').map(p=>p[0]).slice(0,2).join('') %>
            </div>
            <div>
              <h1 class="font-display font-extrabold text-2xl text-navy-800"><%= cand.full_name %></h1>
              <div class="text-slate-600"><%= cand.specialty %> • <%= cand.experience_years %> years • <%= cand.city %></div>
              <div class="flex gap-2 mt-2">
                <% if (cand.pmdc_verified) { %><span class="badge badge-green">PMDC Verified — <%= cand.pmdc_number %></span><% } %>
                <span class="badge badge-teal"><%= cand.availability %></span>
                <% if (cand.open_to_remote) { %><span class="badge badge-lavender">Remote OK</span><% } %>
              </div>
            </div>
          </div>
          <a href="/book-appointment?doctor_id=<%= cand.id %>" class="btn btn-primary">Book Appointment</a>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mt-6 pt-6 border-t border-slate-100">
          <div>
            <div class="text-xs uppercase tracking-wider font-bold text-teal-700 mb-1">Bio</div>
            <p class="text-sm text-slate-700"><%= cand.bio || 'No bio yet.' %></p>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-bold text-teal-700 mb-1">Contact</div>
            <div class="text-sm"><span class="text-slate-500">Email:</span> <%= cand.email %></div>
            <% if (cand.phone) { %><div class="text-sm"><span class="text-slate-500">Phone:</span> <%= cand.phone %></div><% } %>
            <div class="text-sm"><span class="text-slate-500">Languages:</span> <%= cand.languages || '—' %></div>
            <div class="text-sm"><span class="text-slate-500">Qualifications:</span> <%= cand.qualifications || '—' %></div>
          </div>
        </div>

        <% if (cand.cv_summary || cand.cv_experience || cand.cv_education) { %>
          <div class="mt-6 pt-6 border-t border-slate-100">
            <h2 class="font-display font-bold text-lg text-navy-800 mb-3">CV</h2>
            <% if (cand.cv_summary) { %><div class="mb-3"><div class="text-xs uppercase font-bold text-slate-500">Summary</div><p class="text-sm text-slate-700 whitespace-pre-line"><%= cand.cv_summary %></p></div><% } %>
            <% if (cand.cv_skills) { %><div class="mb-3"><div class="text-xs uppercase font-bold text-slate-500">Skills</div><div class="flex flex-wrap gap-1 mt-1"><% cand.cv_skills.split(',').forEach(s => { %><span class="badge badge-lavender"><%= s.trim() %></span><% }) %></div></div><% } %>
            <% if (cand.cv_experience) { %><div class="mb-3"><div class="text-xs uppercase font-bold text-slate-500">Experience</div><p class="text-sm text-slate-700 whitespace-pre-line"><%= cand.cv_experience %></p></div><% } %>
            <% if (cand.cv_education) { %><div class="mb-3"><div class="text-xs uppercase font-bold text-slate-500">Education</div><p class="text-sm text-slate-700 whitespace-pre-line"><%= cand.cv_education %></p></div><% } %>
            <% if (cand.cv_certifications) { %><div class="mb-3"><div class="text-xs uppercase font-bold text-slate-500">Certifications</div><p class="text-sm text-slate-700 whitespace-pre-line"><%= cand.cv_certifications %></p></div><% } %>
          </div>
        <% } %>

        <% if (creds.length) { %>
          <div class="mt-6 pt-6 border-t border-slate-100">
            <h2 class="font-display font-bold text-lg text-navy-800 mb-3">Credentials</h2>
            <div class="divide-y divide-slate-100">
              <% creds.forEach(c => { %>
                <div class="py-2 flex items-center justify-between">
                  <div>
                    <div class="font-semibold text-navy-800 text-sm"><%= c.title %></div>
                    <div class="text-xs text-slate-500"><%= c.cred_type %></div>
                  </div>
                  <span class="badge <%= c.verified?'badge-green':'badge-amber' %>"><%= c.verified?'Verified':'Pending' %></span>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

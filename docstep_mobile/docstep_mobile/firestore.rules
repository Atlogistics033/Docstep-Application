rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    // Helper to check if a document belongs to the logged-in user
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Helper to check if the user is an admin
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Helper to check if a doctor profile belongs to the logged-in user
    function isProfileDoctor(doctorId) {
      return isSignedIn() && (
        doctorId == request.auth.uid ||
        (exists(/databases/$(database)/documents/doctor_profiles/$(doctorId)) &&
         get(/databases/$(database)/documents/doctor_profiles/$(doctorId)).data.user_id == request.auth.uid)
      );
    }
    // Helper to check if an employer profile belongs to the logged-in user
    function isProfileEmployer(employerId) {
      return isSignedIn() && (
        employerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/employer_profiles/$(employerId)) &&
         get(/databases/$(database)/documents/employer_profiles/$(employerId)).data.user_id == request.auth.uid)
      );
    }
    // 1. Users Collection Rules
    match /users/{userId} {
      // Users can read other users' names/public details (needed for forum authors, candidate views)
      allow read: if isSignedIn();
      // Users can only write/update their own accounts, or admins can write
      allow create: if true; // Allow initial sign-up
      allow update, delete: if isOwner(userId) || isAdmin();
    }
    
    // 2. Doctor Profiles Rules
    match /doctor_profiles/{profileId} {
      // Anyone can read doctor profiles (employers need to browse them, homepage shows them)
      allow read: if true;
      // Only the doctor owning the profile can create/update it, or admins
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 3. Employer Profiles Rules
    match /employer_profiles/{profileId} {
      // Publicly readable so doctors can see who posted jobs
      allow read: if true;
      // Only the employer owning the profile can create/update it, or admins
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
    // 3b. Patient Profiles Rules
    match /patient_profiles/{profileId} {
      allow read: if isSignedIn() && (profileId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (profileId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    // 4. Doctor Credentials Rules
    match /credentials/{credId} {
      // Read: The doctor themselves, employers who need to verify candidates, or admins
      allow read: if isSignedIn();
      // Create: Doctor can upload their own credential
      allow create: if isSignedIn() && isProfileDoctor(request.resource.data.doctor_id);
      // Update/Delete: Only the doctor or admin can modify/delete
      allow update, delete: if (isSignedIn() && isProfileDoctor(resource.data.doctor_id)) || isAdmin();
    }
    // 5. Jobs Rules
    match /jobs/{jobId} {
      // Publicly readable so anyone can search for jobs
      allow read: if true;
      // Create: Only authenticated employers can post jobs
      allow create: if isSignedIn() && isProfileEmployer(request.resource.data.employer_id);
      // Update/Delete: Only the employer owning the job can update/delete it, or admins
      allow update, delete: if (isSignedIn() && isProfileEmployer(request.resource.data.employer_id)) || isAdmin();
    }
    // 6. Applications Rules
    match /applications/{appId} {
      // Read: The doctor who applied, the employer who owns the job, or admins
      allow read: if isSignedIn() && (
        isProfileDoctor(resource.data.doctor_id) || 
        isProfileEmployer(get(/databases/$(database)/documents/jobs/$(resource.data.job_id)).data.employer_id) ||
        isAdmin()
      );
      // Create: Only doctor can apply to a job
      allow create: if isSignedIn() && isProfileDoctor(request.resource.data.doctor_id);
      // Update: Doctor can update, or employer can update application status (shortlist, reject)
      allow update: if isSignedIn() && (
        isProfileDoctor(resource.data.doctor_id) || 
        isProfileEmployer(get(/databases/$(database)/documents/jobs/$(resource.data.job_id)).data.employer_id) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    // 7. Interviews Rules
    match /interviews/{interviewId} {
      // Read: The doctor or employer associated with the interview
      allow read: if isSignedIn();
      // Create/Update: Only employers associated with the job application can schedule interviews, or admins
      allow create, update: if isSignedIn() && (
        isProfileEmployer(get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(request.resource.data.application_id)).data.job_id)).data.employer_id) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    // 8. Courses & Success Stories Rules
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /success_stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 9. Community Posts Rules
    match /community_posts/{postId} {
      allow read: if true; // Public forum readable by all
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
    }
    // 10. Community Replies Rules
    match /community_replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
    }
    // 11. Contact Messages Rules
    match /contact_messages/{messageId} {
      // Anyone can submit a contact query (unauthenticated contact page)
      allow create: if true;
      // Only administrators can read support tickets
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    // 12. Notifications Rules
    match /notifications/{notifId} {
      // Users can only read and update (e.g. mark read) their own notifications
      allow read, update: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create, delete: if isAdmin();
    }
    // 13. Appointments Rules
    match /appointments/{appId} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }
  }
}
